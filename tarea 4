# =============================================================================
# SECCIÓN 3. INTERFAZ GRÁFICA BÁSICA CON TKINTER - AL PRINCIPIO DEL CÓDIGO
# =============================================================================
# Esta sección se ubicó deliberadamente al comienzo del archivo (después de la
# documentación, los imports y las constantes) porque se pidió que la interfaz
# gráfica fuera lo primero que se encontrara al abrir el código.
#
# ¿POR QUÉ PUEDE ESTAR AQUÍ SI USA CLASES QUE APARECEN MÁS ABAJO?
#   Python no ejecuta el cuerpo de los métodos cuando define la clase: solo lo
#   hace cuando se llama a la ventana, y la ventana se crea en main() cuando
#   TODO el archivo ya está cargado. Por eso esta clase puede usar Cliente,
#   Servicio, Reserva, TipoCliente, etc. aunque estén definidos más abajo.
#   Los nombres se resuelven en tiempo de ejecución, no al definir la clase.
#
# ESTRUCTURA VISUAL DE LA VENTANA
#   +-----------------------------------------------------------------------+
#   | Encabezado azul: Software FJ + contadores del sistema                 |
#   +-----------------------------------------------------------------------+
#   | [ Clientes ] [ Servicios ] [ Reservas ]  <- pestañas del Notebook    |
#   |                                                                       |
#   |   Formulario (izquierda)          Tabla de datos (derecha)            |
#   +-----------------------------------------------------------------------+
#   | Barra de estado: último mensaje + nombre del log + botón "Ver log"    |
#   +-----------------------------------------------------------------------+
#
# La ventana NO contiene reglas del negocio: solo recoge datos, llama a los
# métodos de SistemaGestionFJ y muestra los resultados. Así se mantiene la
# separación entre la interfaz (Tkinter) y el modelo (clases del sistema).


class VentanaSoftwareFJ:
    """
    Ventana principal del sistema Software FJ (interfaz gráfica básica).

    Recibe un objeto SistemaGestionFJ ya creado y permite:
      1. Registrar clientes desde un formulario.
      2. Registrar los tres tipos de servicio.
      3. Crear reservas y confirmarlas, cancelarlas o procesarlas.
      4. Ver las tablas de clientes, servicios y reservas.
      5. Abrir el archivo de logs.

    Todos los errores del negocio se capturan y se muestran en un cuadro de
    diálogo; la aplicación nunca se cierra por un dato inválido.
    """

    # ------------------------- CONSTANTES DE ESTILO -------------------------
    # Se guardan como atributos de la clase para no repetir colores y medidas.
    TITULO = "Software FJ - Gestión de Clientes, Servicios y Reservas"
    ANCHO = 1120
    ALTO = 730

    COLOR_FONDO = "#eef2f5"
    COLOR_ENCABEZADO = "#12355b"
    COLOR_TEXTO = "#1f2933"
    COLOR_TEXTO_CLARO = "#dbe7f1"
    COLOR_EXITO = "#1b7f3b"
    COLOR_ERROR = "#b3261e"
    COLOR_BARRA = "#dfe5ea"
    FUENTE = ("Segoe UI", 9)

    # Nombres visibles de los tres tipos de servicio (para el Combobox).
    TIPO_SALA = "Reserva de salas"
    TIPO_EQUIPO = "Alquiler de equipos"
    TIPO_ASESORIA = "Asesoría especializada"

    def __init__(self, sistema: "SistemaGestionFJ") -> None:
        """
        Construye la ventana y todos sus widgets.

        Parámetro:
            sistema: instancia de SistemaGestionFJ con las listas internas.
        """
        # Si Tkinter no está instalado, esta clase no se debe instanciar.
        if not TKINTER_DISPONIBLE:
            raise RuntimeError("Tkinter no está disponible en este equipo.")

        self._sistema = sistema

        # 1) Ventana raíz de Tkinter.
        self._ventana = tk.Tk()
        self._ventana.title(self.TITULO)
        self._ventana.geometry(f"{self.ANCHO}x{self.ALTO}")
        self._ventana.minsize(980, 650)
        self._ventana.configure(bg=self.COLOR_FONDO)

        # El botón X de la ventana pasa por _cerrar() para preguntar al usuario.
        self._ventana.protocol("WM_DELETE_WINDOW", self._cerrar)

        # Distribución general: fila 0 encabezado, fila 1 pestañas, fila 2 barra.
        self._ventana.columnconfigure(0, weight=1)
        self._ventana.rowconfigure(1, weight=1)

        # 2) Construcción ordenada de la interfaz.
        #    Si algo falla al crear los widgets, se destruye la ventana para
        #    no dejar una ventana a medio construir y se propaga el error.
        try:
            self._configurar_estilos()
            self._crear_variables()
            self._crear_encabezado()
            self._crear_pestanas()
            self._crear_barra_estado()
            self._inicializar_valores()
            self._actualizar_todo()
            self._centrar_ventana()
        except Exception:
            self._ventana.destroy()
            raise

    def iniciar(self) -> None:
        """Muestra la ventana y entrega el control al bucle de Tkinter."""
        self._ventana.mainloop()

    # =========================================================================
    # CONSTRUCCIÓN DE LA VENTANA
    # =========================================================================
    def _configurar_estilos(self) -> None:
        """
        Ajusta colores, fuentes y tamaños de los widgets ttk.
        Se usa el tema "clam" porque está disponible en Windows, Linux y macOS;
        si no existe, se conserva el tema por defecto sin romper el programa.
        """
        estilo = ttk.Style(self._ventana)
        try:
            estilo.theme_use("clam")
        except tk.TclError:
            pass

        estilo.configure("TFrame", background=self.COLOR_FONDO)
        estilo.configure(
            "TLabel",
            background=self.COLOR_FONDO,
            foreground=self.COLOR_TEXTO,
            font=self.FUENTE,
        )
        estilo.configure("TLabelframe", background=self.COLOR_FONDO)
        estilo.configure(
            "TLabelframe.Label",
            background=self.COLOR_FONDO,
            foreground=self.COLOR_ENCABEZADO,
            font=("Segoe UI", 10, "bold"),
        )
        estilo.configure("TNotebook", background=self.COLOR_FONDO, borderwidth=0)
        # La pestaña activa se pinta de blanco y las demás en azul grisáceo,
        # para que el usuario vea con claridad dónde está.
        estilo.configure(
            "TNotebook.Tab",
            font=("Segoe UI", 10, "bold"),
            padding=(14, 6),
            background="#d3dfe9",
            foreground="#33475b",
        )
        estilo.map(
            "TNotebook.Tab",
            background=[("selected", "white")],
            foreground=[("selected", self.COLOR_ENCABEZADO)],
        )
        estilo.configure(
            "Treeview",
            font=self.FUENTE,
            rowheight=24,
            background="white",
            fieldbackground="white",
        )
        estilo.configure(
            "Treeview.Heading",
            font=("Segoe UI", 9, "bold"),
            background="#dce6ef",
        )
        estilo.configure("TEntry", fieldbackground="white")
        estilo.configure("TButton", font=self.FUENTE, padding=(8, 4))
        estilo.configure(
            "Accion.TButton", font=("Segoe UI", 9, "bold"), padding=(10, 5)
        )

