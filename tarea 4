# SECCIÓN 3. INTERFAZ GRÁFICA BÁSICA CON TKINTER
# La ventana se crea en main(), cuando el resto de clases ya está definido.
# Solo recoge datos y delega las reglas del negocio en SistemaGestionFJ.
# Pestañas: Clientes, Servicios y Reservas; estado y log en la barra inferior.


class VentanaSoftwareFJ:
    """
    Ventana principal construida con Tkinter.

    Responsabilidades:
    - Mostrar los formularios de clientes, servicios y reservas.
    - Mostrar las tablas con la información registrada.
    - Llamar a los métodos de SistemaGestionFJ y presentar sus resultados.
    - Informar los errores sin cerrar la aplicación.

    No contiene reglas del negocio: la validación, el cálculo de costos y los
    cambios de estado viven en las clases del modelo.
    """
    TITULO = "Software FJ - Gestión de Clientes, Servicios y Reservas"
    ANCHO, ALTO = 1120, 730
    COLOR_FONDO = "#eef2f5"
    COLOR_ENCABEZADO = "#12355b"
    COLOR_TEXTO = "#1f2933"
    COLOR_TEXTO_CLARO = "#dbe7f1"
    COLOR_EXITO = "#1b7f3b"
    COLOR_ERROR = "#b3261e"
    COLOR_BARRA = "#dfe5ea"
    FUENTE = ("Segoe UI", 9)
    TIPO_SALA = "Reserva de salas"
    TIPO_EQUIPO = "Alquiler de equipos"
    TIPO_ASESORIA = "Asesoría especializada"

    def __init__(self, sistema: "SistemaGestionFJ") -> None:
        """Construye la ventana, estilos, pestañas y barra de estado."""
        if not TKINTER_DISPONIBLE:
            raise RuntimeError("Tkinter no está disponible en este equipo.")
        self._sistema = sistema
        # Ventana raíz: tamaño, color y cierre controlado.
        self._ventana = tk.Tk()
        self._ventana.title(self.TITULO)
        self._ventana.geometry(f"{self.ANCHO}x{self.ALTO}")
        self._ventana.minsize(980, 650)
        self._ventana.configure(bg=self.COLOR_FONDO)
        self._ventana.protocol("WM_DELETE_WINDOW", self._cerrar)
        # Fila 0: encabezado; fila 1: pestañas; fila 2: barra de estado.
        self._ventana.columnconfigure(0, weight=1)
        self._ventana.rowconfigure(1, weight=1)
        try:
            self._configurar_estilos()
            self._crear_variables()
            self._crear_encabezado()
            self._crear_pestanas()
            self._crear_barra_estado()
            self._inicializar_valores()
            self._actualizar_todo()
            self._centrar_ventana()
        except Exception:
            # Si falla la construcción, se destruye la ventana a medias.
            self._ventana.destroy()
            raise

    def iniciar(self) -> None:
        """Inicia el bucle gráfico de Tkinter."""
        self._ventana.mainloop()

    # ------------------------------ ESTILO ---------------------------------
    def _configurar_estilos(self) -> None:
        """Define colores, fuentes y estilos de los widgets."""
        estilo = ttk.Style(self._ventana)
        # "clam" está disponible en Windows, Linux y macOS; si falla, se usa
        # el tema nativo del sistema sin interrumpir el programa.
        try:
            estilo.theme_use("clam")
        except tk.TclError:
            pass
        estilo.configure("TFrame", background=self.COLOR_FONDO)
        estilo.configure("TLabel", background=self.COLOR_FONDO,
                         foreground=self.COLOR_TEXTO, font=self.FUENTE)
        estilo.configure("TLabelframe", background=self.COLOR_FONDO)
        estilo.configure("TLabelframe.Label", background=self.COLOR_FONDO,
                         foreground=self.COLOR_ENCABEZADO,
                         font=("Segoe UI", 10, "bold"))
        # La pestaña activa se resalta en blanco.
        estilo.configure("TNotebook.Tab", font=("Segoe UI", 10, "bold"),
                         padding=(14, 6), background="#d3dfe9",
                         foreground="#33475b")
        estilo.map("TNotebook.Tab", background=[("selected", "white")],
                   foreground=[("selected", self.COLOR_ENCABEZADO)])
        estilo.configure("Treeview", font=self.FUENTE, rowheight=24,
                         background="white", fieldbackground="white")
        estilo.configure("Treeview.Heading", font=("Segoe UI", 9, "bold"))
        estilo.configure("Accion.TButton", font=("Segoe UI", 9, "bold"),
                         padding=(10, 5))

    def _crear_variables(self) -> None:
        """Crea las variables de Tkinter enlazadas a los campos."""
        # Cada nombre se convierte en un StringVar accesible como self._nombre.
        for nombre in (
            "cli_documento", "cli_nombre", "cli_apellido", "cli_correo",
            "cli_telefono", "cli_direccion", "cli_tipo",
            "srv_tipo", "srv_codigo", "srv_nombre", "srv_tarifa",
            "srv_tipo_sala", "srv_capacidad", "srv_equipo", "srv_marca",
            "srv_especialidad", "srv_nivel", "srv_asesor",
            "res_documento", "res_servicio", "res_fecha", "res_hora",
            "res_cantidad", "res_iva", "res_descuento", "res_observaciones",
            "res_motivo",
        ):
            setattr(self, f"_{nombre}", tk.StringVar(master=self._ventana))
        # Las casillas usan BooleanVar y tienen un valor inicial.
        for nombre, valor in {
            "srv_disponible": True, "srv_equipada": True, "srv_seguro": False,
        }.items():
            setattr(
                self, f"_{nombre}",
                tk.BooleanVar(master=self._ventana, value=valor),
            )

