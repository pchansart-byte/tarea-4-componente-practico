def _listar_para_gestionar(sistema, estados, titulo):
    """Lista las reservas que están en ciertos estados."""
    print(f"\n{titulo}:")
    reservas = [r for r in sistema.reservas if r.estado in estados]
    for r in reservas:
        print(f"   {r.id} | {r.estado.value} | {r.cliente.nombre_completo()}"
              f" | {r.servicio.codigo} | {formatear_fecha(r.inicio)}")
    if not reservas:
        print("  (ninguna)")

def accion_confirmar_reserva(sistema: SistemaGestionFJ) -> None:
