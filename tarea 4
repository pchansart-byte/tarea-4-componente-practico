def accion_registrar_cliente(sistema: SistemaGestionFJ) -> None:
    """Flujo guiado para registrar un cliente."""
    print(f"\n{SUBSECCION}\n REGISTRO DE CLIENTE\n{SUBSECCION}")
    # El usuario elige el tipo y luego se piden los datos uno por uno.
    tipo = TipoCliente.EMPRESA if pedir_opcion(
        "Tipo (1 = natural, 2 = empresa): ", ("1", "2")) == "2" else TipoCliente.NATURAL
    try:
        cliente = sistema.registrar_cliente(
            documento=pedir_texto("Documento: "),
            nombre=pedir_texto("Nombre: "),
            apellido=pedir_texto("Apellido: "),
            correo=pedir_texto("Correo: "),
            telefono=pedir_texto("Teléfono: "),
            direccion=pedir_texto("Dirección (opcional): ", obligatorio=False),
            tipo=tipo,
        )
    except ErrorSistemaFJ as error:
        print(f"\n  [X] No se pudo registrar: {error}")
    else:
        print(f"\n  [OK] Cliente registrado:\n{cliente.describir()}")

def accion_registrar_servicio(sistema: SistemaGestionFJ) -> None:
    """Flujo guiado para registrar un servicio."""
    print(f"\n{SUBSECCION}\n REGISTRO DE SERVICIO\n{SUBSECCION}")
    print("  1) Sala   2) Equipos   3) Asesoría")
    # El código lo escribe el usuario: no hay valor por defecto.
    tipo = pedir_opcion("Tipo (1-3): ", ("1", "2", "3"))
    codigo = pedir_texto("Código único: ", longitud_maxima=20)
    nombre = pedir_texto("Nombre: ")
    tarifa = pedir_decimal(
        f"Tarifa por {'día' if tipo == '2' else 'hora'}: ",
        Decimal("0.01"), Decimal("100000000"))
    disponible = pedir_si_no("¿Disponible? (s/n) [s]: ", True)
    try:
        # Se piden solo los campos propios del tipo seleccionado.
        if tipo == "1":
            tipo_sala = TipoSala[
                {"1": "SALA_JUNTAS", "2": "SALA_SISTEMAS",
                 "3": "AUDITORIO"}[pedir_opcion(
                    "Sala (1 juntas, 2 sistemas, 3 auditorio): ", ("1", "2", "3"))]]
            servicio = ReservaSalas(
                codigo, nombre, tarifa, tipo_sala,
                pedir_entero("Capacidad: ", 1, 500),
                pedir_si_no("¿Equipada? (s/n) [s]: ", True), disponible)
        elif tipo == "2":
            servicio = AlquilerEquipos(
                codigo, nombre, tarifa, pedir_texto("Equipo: "),
                pedir_texto("Marca (opcional): ", obligatorio=False),
                pedir_si_no("¿Seguro del 8%? (s/n) [n]: ", False), disponible)
        else:
            nivel = NivelAsesor[
                {"1": "JUNIOR", "2": "SENIOR", "3": "EXPERTO"}[pedir_opcion(
                    "Nivel (1 junior, 2 senior, 3 experto): ", ("1", "2", "3"))]]
            servicio = AsesoriaEspecializada(
                codigo, nombre, tarifa, pedir_texto("Especialidad: "),
                nivel, pedir_texto("Asesor: "), disponible)
        registrado = sistema.registrar_servicio(servicio)
    except ErrorSistemaFJ as error:
        print(f"\n  [X] No se pudo registrar: {error}")
    else:
        print(f"\n  [OK] Servicio registrado:\n{registrado.describir()}")

def accion_crear_reserva(sistema: SistemaGestionFJ) -> None:
    """Flujo guiado para crear una reserva."""
    print(f"\n{SUBSECCION}\n CREAR RESERVA\n{SUBSECCION}")
    # Sin clientes o sin servicios disponibles no se puede continuar.
    if not sistema.clientes or not sistema.servicios_disponibles():
        print("  [!] Registre al menos un cliente y un servicio disponible.")
        return
    print(" Servicios disponibles:")
    for s in sistema.servicios_disponibles():
        print(f"   {s.codigo} | {s.nombre} | {formatear_moneda(s.tarifa_base)}"
              f" por {s.unidad_medida}")
    # Se piden las entidades y los datos de la reserva.
    documento = pedir_texto("Documento del cliente: ")
    codigo = pedir_texto("Código del servicio: ")
    try:
        servicio = sistema.buscar_servicio(codigo)
        inicio = pedir_fecha_hora("Inicio")
        cantidad = pedir_decimal(
            f"Cantidad ({servicio.cantidad_minima} a "
            f"{servicio.cantidad_maxima} {servicio.unidad_plural}): ",
            servicio.cantidad_minima, servicio.cantidad_maxima)
        # El IVA y el descuento se piden en porcentaje y se convierten a tasa.
        iva = pedir_decimal("IVA % [19]: ", Decimal("0"), Decimal("50"),
                            Decimal("19"))
        descuento = pedir_decimal("Descuento % [0]: ", Decimal("0"),
                                  Decimal("50"), Decimal("0"))
        reserva = sistema.crear_reserva(
            documento, codigo, inicio, cantidad, iva / Decimal("100"),
            descuento / Decimal("100"),
            pedir_texto("Observaciones: ", obligatorio=False))
    except ErrorSistemaFJ as error:
        print(f"\n  [X] No se pudo crear: {error}")
    else:
        print(f"\n  [OK] Reserva creada:\n{reserva.describir()}")

