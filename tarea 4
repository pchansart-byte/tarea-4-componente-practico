    def _inicializar_valores(self) -> None:
        """Valores iniciales cómodos para que el usuario no empiece en blanco."""
        self._cli_tipo.set(TipoCliente.NATURAL.value)
        self._srv_tipo.set(self.TIPO_SALA)
        self._srv_tipo_sala.set(TipoSala.SALA_JUNTAS.value)
        self._srv_nivel.set(NivelAsesor.JUNIOR.value)

        # La reserva se propone para mañana a las 9:00.
        self._res_fecha.set(
            (datetime.now() + timedelta(days=1)).strftime("%d/%m/%Y")
        )
        self._res_hora.set("09:00")
        self._res_iva.set("19")
        self._res_descuento.set("0")

        # Muestra únicamente los campos del tipo de servicio inicial.
        self._cambiar_tipo_servicio()

    # =========================================================================
    # ACTUALIZACIÓN DE TABLAS Y CONTADORES
    # =========================================================================
    def _actualizar_todo(self) -> None:
        """Refresca las tres tablas y los contadores del encabezado."""
        self._actualizar_clientes()
        self._actualizar_servicios()
        self._actualizar_reservas()
        self._actualizar_resumen()

    def _actualizar_resumen(self) -> None:
        """Actualiza el texto 'Clientes: X | Servicios: Y | Reservas: Z'."""
        self._etiqueta_resumen.config(
            text=(
                f"Clientes: {len(self._sistema.clientes)}   |   "
                f"Servicios: {len(self._sistema.servicios)}   |   "
                f"Reservas: {len(self._sistema.reservas)}"
            )
        )

    def _actualizar_clientes(self) -> None:
        """Vuelve a llenar la tabla de clientes desde las listas del sistema."""
        for item in self._tabla_clientes.get_children():
            self._tabla_clientes.delete(item)
        for cliente in self._sistema.clientes:
            self._tabla_clientes.insert(
                "",
                "end",
                iid=cliente.id,
                values=(
                    cliente.id,
                    cliente.documento_mascarado(),
                    self._recortar(cliente.nombre_completo(), 30),
                    cliente.tipo.value,
                    "Activo" if cliente.activo else "Inactivo",
                ),
            )

    def _actualizar_servicios(self) -> None:
        """Vuelve a llenar la tabla de servicios."""
        for item in self._tabla_servicios.get_children():
            self._tabla_servicios.delete(item)

        for servicio in self._sistema.servicios:
            # Etiqueta corta según la clase real del servicio (polimorfismo).
            if isinstance(servicio, ReservaSalas):
                tipo = "Sala"
            elif isinstance(servicio, AlquilerEquipos):
                tipo = "Equipos"
            else:
                tipo = "Asesoría"

            self._tabla_servicios.insert(
                "",
                "end",
                iid=servicio.codigo,
                values=(
                    servicio.codigo,
                    self._recortar(servicio.nombre, 34),
                    tipo,
                    formatear_moneda(servicio.tarifa_base),
                    "Sí" if servicio.disponible else "No",
                ),
            )

    def _actualizar_reservas(self) -> None:
        """Vuelve a llenar la tabla de reservas."""
        for item in self._tabla_reservas.get_children():
            self._tabla_reservas.delete(item)

        for reserva in self._sistema.reservas:
            self._tabla_reservas.insert(
                "",
                "end",
                iid=reserva.id,
                values=(
                    reserva.id,
                    self._recortar(reserva.cliente.nombre_completo(), 24),
                    reserva.servicio.codigo,
                    formatear_fecha(reserva.inicio),
                    reserva.estado.value,
                    formatear_moneda(reserva.total),
                ),
            )

    # =========================================================================
    # ACCIONES DE LA PESTAÑA CLIENTES
    # =========================================================================
    def _registrar_cliente(self) -> None:
        """Toma los datos del formulario y registra un cliente."""
        # El Combobox muestra el texto bonito; el sistema espera el enum.
        tipo = (
            TipoCliente.EMPRESA
            if self._cli_tipo.get() == TipoCliente.EMPRESA.value
            else TipoCliente.NATURAL
        )

        try:
            cliente = self._sistema.registrar_cliente(
                documento=self._cli_documento.get(),
                nombre=self._cli_nombre.get(),
                apellido=self._cli_apellido.get(),
                correo=self._cli_correo.get(),
                telefono=self._cli_telefono.get(),
                direccion=self._cli_direccion.get(),
                tipo=tipo,
            )
        except ErrorSistemaFJ as error:
            # Error de validación o documento duplicado: se informa y no se cierra.
            self._mostrar_error(error)
        except Exception as error:  # red de seguridad de la interfaz
            self._mostrar_error_inesperado(error)
        else:
            self._mostrar_ok(
                f"Cliente {cliente.id} registrado: {cliente.nombre_completo()}."
            )
            self._limpiar_cliente()
            self._actualizar_clientes()
            self._actualizar_resumen()

    def _limpiar_cliente(self) -> None:
        """Vacía el formulario de clientes."""
        for variable in (
            self._cli_documento,
            self._cli_nombre,
            self._cli_apellido,
            self._cli_correo,
            self._cli_telefono,
            self._cli_direccion,
        ):
            variable.set("")
        self._cli_tipo.set(TipoCliente.NATURAL.value)

    # =========================================================================
    # ACCIONES DE LA PESTAÑA SERVICIOS
    # =========================================================================
    def _cambiar_tipo_servicio(self, evento=None) -> None:
        """
        Muestra los campos del servicio seleccionado y oculta los demás.

        El parámetro 'evento' llega cuando el método se usa como callback de
        Combobox; por eso tiene valor por defecto None.
        """
        seleccion = self._srv_tipo.get()

        # grid_remove() oculta el marco pero recuerda su posición en la grilla.
        for marco in (self._marco_sala, self._marco_equipo, self._marco_asesoria):
            marco.grid_remove()

        if seleccion == self.TIPO_SALA:
            self._marco_sala.grid()
        elif seleccion == self.TIPO_EQUIPO:
            self._marco_equipo.grid()
        else:
            self._marco_asesoria.grid()

        # Si el código está vacío, sugerimos uno libre para ese tipo de
        # servicio (por ejemplo SRV-SALA-02). El usuario puede cambiarlo.
        if not self._srv_codigo.get().strip():
            prefijos = {
                self.TIPO_SALA: "SRV-SALA",
                self.TIPO_EQUIPO: "SRV-EQP",
                self.TIPO_ASESORIA: "SRV-ASE",
            }
            self._srv_codigo.set(self._sistema.siguiente_codigo(prefijos[seleccion]))

    def _registrar_servicio(self) -> None:
        """Construye el servicio elegido y lo registra en el sistema."""
        tipo = self._srv_tipo.get()
        codigo = self._srv_codigo.get()
        nombre = self._srv_nombre.get()
        tarifa = self._srv_tarifa.get()
        disponible = bool(self._srv_disponible.get())

        try:
            if tipo == self.TIPO_SALA:
                # Convertimos el texto del combo al enum TipoSala.
                mapa_salas = {sala.value: sala for sala in TipoSala}
                tipo_sala = mapa_salas.get(self._srv_tipo_sala.get())
                if tipo_sala is None:
                    raise DatosInvalidosError("Seleccione un tipo de sala válido.")
                servicio = ReservaSalas(
                    codigo,
                    nombre,
                    tarifa,
                    tipo_sala,
                    self._srv_capacidad.get(),
                    bool(self._srv_equipada.get()),
                    disponible,
                )
            elif tipo == self.TIPO_EQUIPO:
                servicio = AlquilerEquipos(
                    codigo,
                    nombre,
                    tarifa,
                    self._srv_equipo.get(),
                    self._srv_marca.get(),
                    bool(self._srv_seguro.get()),
                    disponible,
                )
            elif tipo == self.TIPO_ASESORIA:
                mapa_niveles = {nivel.value: nivel for nivel in NivelAsesor}
                nivel = mapa_niveles.get(self._srv_nivel.get())
                if nivel is None:
                    raise DatosInvalidosError(
                        "Seleccione un nivel de asesor válido."
                    )
                servicio = AsesoriaEspecializada(
                    codigo,
                    nombre,
                    tarifa,
                    self._srv_especialidad.get(),
                    nivel,
                    self._srv_asesor.get(),
                    disponible,
                )
            else:
                raise DatosInvalidosError("Seleccione un tipo de servicio válido.")

            registrado = self._sistema.registrar_servicio(servicio)
        except ErrorSistemaFJ as error:
            self._mostrar_error(error)
        except Exception as error:
            self._mostrar_error_inesperado(error)
        else:
            self._mostrar_ok(
                f"Servicio {registrado.codigo} registrado: {registrado.nombre}."
            )
            self._limpiar_servicio()
            self._actualizar_servicios()
            self._actualizar_resumen()

    def _limpiar_servicio(self) -> None:
        """Vacía los campos del formulario de servicios."""
        for variable in (
            self._srv_codigo,
            self._srv_nombre,
            self._srv_tarifa,
            self._srv_capacidad,
            self._srv_equipo,
            self._srv_marca,
            self._srv_especialidad,
            self._srv_asesor,
        ):
            variable.set("")
        self._srv_disponible.set(True)
        # Al quedar el código vacío, se sugiere el siguiente código libre.
        self._cambiar_tipo_servicio()

    # =========================================================================
    # ACCIONES DE LA PESTAÑA RESERVAS
    # =========================================================================
    def _crear_reserva(self) -> None:
        """Toma los datos del formulario y crea una reserva."""
        try:
            # Unimos fecha y hora en un solo datetime.
            try:
                inicio = datetime.strptime(
                    f"{self._res_fecha.get().strip()} "
                    f"{self._res_hora.get().strip()}",
                    "%d/%m/%Y %H:%M",
                )
            except ValueError as error:
                raise DatosInvalidosError(
                    "La fecha u hora no es válida. Use DD/MM/AAAA y HH:MM."
                ) from error

            # Los porcentajes se escriben como 19 y 5; se convierten a 0.19 y 0.05.
            iva = convertir_decimal(
                self._res_iva.get().strip() or "19",
                "IVA (%)",
                Decimal("0"),
                Decimal("50"),
            )
            descuento = convertir_decimal(
                self._res_descuento.get().strip() or "0",
                "descuento (%)",
                Decimal("0"),
                Decimal("50"),
            )

            reserva = self._sistema.crear_reserva(
                documento_cliente=self._res_documento.get(),
                codigo_servicio=self._res_servicio.get(),
                fecha_hora_inicio=inicio,
                cantidad=self._res_cantidad.get(),
                impuesto=iva / Decimal("100"),
                descuento=descuento / Decimal("100"),
                observaciones=self._res_observaciones.get(),
            )
        except ErrorSistemaFJ as error:
            self._mostrar_error(error)
        except Exception as error:
            self._mostrar_error_inesperado(error)
        else:
            self._mostrar_ok(
                f"Reserva {reserva.id} creada por "
                f"{formatear_moneda(reserva.total)}."
            )
            self._limpiar_reserva()
            self._actualizar_reservas()
            self._actualizar_resumen()

    def _limpiar_reserva(self) -> None:
        """Limpia los datos variables y deja una fecha/hora cómoda."""
        self._res_documento.set("")
        self._res_servicio.set("")
        self._res_cantidad.set("")
        self._res_observaciones.set("")
        self._res_motivo.set("")
        self._res_fecha.set(
            (datetime.now() + timedelta(days=1)).strftime("%d/%m/%Y")
        )
        self._res_hora.set("09:00")

    def _reserva_seleccionada(self):
        """
        Devuelve la reserva marcada en la tabla o None si no hay selección.
        El identificador de cada fila (iid) es el mismo ID de la reserva.
        """
        seleccion = self._tabla_reservas.selection()
        if not seleccion:
            messagebox.showinfo(
                "Seleccione una reserva",
                "Haga clic sobre una fila de la tabla de reservas.",
                parent=self._ventana,
            )
            return None

        try:
            return self._sistema.buscar_reserva(seleccion[0])
        except ErrorSistemaFJ as error:
            self._mostrar_error(error)
            return None

    def _confirmar_reserva(self) -> None:
        """Confirma la reserva seleccionada en la tabla."""
        reserva = self._reserva_seleccionada()
        if reserva is None:
            return

        try:
            total = self._sistema.confirmar_reserva(reserva.id)
        except ErrorSistemaFJ as error:
            self._mostrar_error(error)
        except Exception as error:
            self._mostrar_error_inesperado(error)
        else:
            self._mostrar_ok(
                f"Reserva {reserva.id} confirmada por "
                f"{formatear_moneda(total)}."
            )
            self._actualizar_reservas()
            self._actualizar_resumen()

    def _cancelar_reserva(self) -> None:
        """Cancela la reserva seleccionada usando el motivo escrito."""
        reserva = self._reserva_seleccionada()
        if reserva is None:
            return

        motivo = self._res_motivo.get().strip()
        if not motivo:
            messagebox.showinfo(
                "Motivo requerido",
                "Escriba el motivo de la cancelación antes de continuar.",
                parent=self._ventana,
            )
            return

        try:
            self._sistema.cancelar_reserva(reserva.id, motivo)
        except ErrorSistemaFJ as error:
            self._mostrar_error(error)
        except Exception as error:
            self._mostrar_error_inesperado(error)
        else:
            self._mostrar_ok(f"Reserva {reserva.id} cancelada correctamente.")
            self._res_motivo.set("")
            self._actualizar_reservas()
            self._actualizar_resumen()

    def _procesar_reserva(self) -> None:
        """Procesa la reserva seleccionada (servicio prestado)."""
        reserva = self._reserva_seleccionada()
        if reserva is None:
            return

        try:
            total = self._sistema.procesar_reserva(reserva.id)
        except ErrorSistemaFJ as error:
            self._mostrar_error(error)
        except Exception as error:
            self._mostrar_error_inesperado(error)
        else:
            self._mostrar_ok(
                f"Reserva {reserva.id} procesada. "
                f"Valor facturado: {formatear_moneda(total)}."
            )
            self._actualizar_reservas()
            self._actualizar_resumen()

    # =========================================================================
    # MENSAJES Y UTILIDADES GENERALES
    # =========================================================================
    def _mostrar_ok(self, mensaje: str) -> None:
        """Escribe un mensaje de éxito en la barra de estado (color verde)."""
        self._etiqueta_estado.config(text=mensaje, fg=self.COLOR_EXITO)

    def _mostrar_error(self, error: Exception) -> None:
        """Muestra un error de negocio en la barra y en un cuadro de diálogo."""
        self._sistema.registro.advertencia(f"GUI: operación rechazada: {error}")
        self._etiqueta_estado.config(text=f"Error: {error}", fg=self.COLOR_ERROR)
        messagebox.showwarning(
            "Operación rechazada", str(error), parent=self._ventana
        )

    def _mostrar_error_inesperado(self, error: Exception) -> None:
        """Muestra un error no previsto y lo registra como crítico en el log."""
        self._sistema.registro.critico("GUI: error no controlado.", error)
        self._etiqueta_estado.config(
            text="Error inesperado. Revise el archivo de logs.",
            fg=self.COLOR_ERROR,
        )
        messagebox.showerror(
            "Error inesperado",
            "Ocurrió un error inesperado.\n\n"
            f"{error}\n\nRevise el archivo de logs para más detalles.",
            parent=self._ventana,
        )

    def _ver_log(self) -> None:
        """Abre una ventana secundaria con las últimas 200 líneas del log."""
        ventana_log = tk.Toplevel(self._ventana)
        ventana_log.title("Registro de eventos - Software FJ")
        ventana_log.geometry("900x520")
        ventana_log.configure(bg=self.COLOR_FONDO)

        marco = ttk.Frame(ventana_log, padding=10)
        marco.pack(fill="both", expand=True)

        texto = tk.Text(
            marco,
            wrap="none",
            font=("Consolas", 9),
            background="white",
            foreground=self.COLOR_TEXTO,
        )
        barra = ttk.Scrollbar(marco, orient="vertical", command=texto.yview)
        texto.configure(yscrollcommand=barra.set)
        texto.pack(side="left", fill="both", expand=True)
        barra.pack(side="right", fill="y")

        # Leemos el archivo con tolerancia a errores de codificación.
        try:
            with open(
                self._sistema.registro.ruta_archivo,
                "r",
                encoding="utf-8",
                errors="replace",
            ) as archivo:
                lineas = archivo.readlines()[-200:]
        except OSError as error:
            lineas = [f"No se pudo leer el archivo de logs:\n{error}\n"]

        texto.insert("1.0", "".join(lineas))
        texto.configure(state="disabled")  # solo lectura para el usuario

    def _cerrar(self) -> None:
        """Pregunta antes de cerrar la ventana principal."""
        if messagebox.askokcancel(
            "Cerrar Software FJ",
            "¿Desea cerrar la aplicación?",
            parent=self._ventana,
        ):
            self._ventana.destroy()

    def _centrar_ventana(self) -> None:
        """Ubica la ventana en el centro de la pantalla."""
        self._ventana.update_idletasks()
        x = max(0, (self._ventana.winfo_screenwidth() - self.ANCHO) // 2)
        y = max(0, (self._ventana.winfo_screenheight() - self.ALTO) // 3)
        self._ventana.geometry(f"{self.ANCHO}x{self.ALTO}+{x}+{y}")


def iniciar_interfaz_grafica(sistema: "SistemaGestionFJ") -> bool:
    """
    Intenta abrir la interfaz gráfica.

    Devuelve True si la ventana se mostró y se cerró normalmente.
    Devuelve False si Tkinter no está instalado o no hay entorno gráfico;
    en ese caso main() activa automáticamente la interfaz de consola.
    """
    if not TKINTER_DISPONIBLE:
        sistema.registro.advertencia(
            "Tkinter no está disponible; se usará la interfaz de consola."
        )
        print("[AVISO] Tkinter no está disponible. Se iniciará la consola.")
        return False

    try:
        ventana = VentanaSoftwareFJ(sistema)
    except tk.TclError as error:
        # Ocurre en servidores sin pantalla o con el entorno gráfico bloqueado.
        sistema.registro.error(
            "No se pudo iniciar la interfaz gráfica (TclError).", error
        )
        print("[AVISO] No hay entorno gráfico disponible. Se iniciará la consola.")
        return False
    except Exception as error:
        sistema.registro.critico(
            "Error al construir la interfaz gráfica; se usará la consola.", error
        )
        print("[AVISO] No se pudo iniciar la interfaz gráfica. Se usará la consola.")
        return False

    ventana.iniciar()
    return True


