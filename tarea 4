    print(f"\n{SUBSECCION}\n CONFIRMAR RESERVA\n{SUBSECCION}")
    _listar_para_gestionar(sistema, (EstadoReserva.PENDIENTE,), "Pendientes")
    if not sistema.reservas_por_estado(EstadoReserva.PENDIENTE):
        return
    try:
        total = sistema.confirmar_reserva(
            pedir_texto("ID de la reserva: "))
    except ErrorSistemaFJ as error:
        print(f"\n  [X] {error}")
    else:
        print(f"\n  [OK] Confirmada por {formatear_moneda(total)}.")

