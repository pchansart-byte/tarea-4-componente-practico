def bucle_principal(sistema: SistemaGestionFJ) -> None:
    """Muestra el menú y ejecuta la opción elegida hasta que el usuario salga."""
    acciones: Dict[str, Callable[[SistemaGestionFJ], None]] = {
        "1": accion_registrar_cliente,
        "2": accion_registrar_servicio,
        "3": accion_crear_reserva,
        "4": accion_listar_clientes,
        "5": accion_listar_servicios,
        "6": accion_listar_reservas,
        "7": accion_buscar_cliente,
        "8": accion_confirmar_reserva,
        "9": accion_cancelar_reserva,
        "10": accion_procesar_reserva,
        "11": accion_demostracion,
        "12": accion_ver_log,
    }

    while True:
        mostrar_menu(sistema)
        opcion = pedir_texto("Seleccione una opción: ")

        if opcion == "0":
            print("\n  Cerrando el sistema. ¡Hasta pronto!\n")
            return

        accion = acciones.get(opcion)
        if accion is None:
            print("\n  [!] Opción no válida. Digite un número del menú.")
            pausar()
            continue

        try:
            accion(sistema)
        except SalidaSolicitada:
            raise  # el cierre ordenado lo maneja main()
        except KeyboardInterrupt:
            raise  # Ctrl+C también se cierra de forma ordenada en main()
        except ErrorSistemaFJ as error:
            # Red de seguridad: ninguna opción debe tumbar el menú.
            sistema.registro.error("Operación del menú rechazada.", error)
            print(f"\n  [X] {error}")
        except Exception as error:
            sistema.registro.critico("Error no controlado en una opción del menú.", error)
            print("\n  [X] Ocurrió un error inesperado. Revise el archivo de logs.")

        # La pausa se hace al final y NO dentro de un finally: así, si el
        # usuario interrumpe con Ctrl+C o se acaba la entrada, el programa
        # sale de inmediato sin quedarse esperando un ENTER adicional.
        pausar()


# =============================================================================
# SECCIÓN 14. PUNTO DE ENTRADA DEL PROGRAMA
# =============================================================================
def main(argv: Optional[List[str]] = None) -> int:
    """
    Punto de entrada.

    Modos:
      python software_fj.py            -> interfaz gráfica (Tkinter)
      python software_fj.py --consola  -> menú de texto (si no hay gráficos)
      python software_fj.py --demo     -> demostración automática y salida
      python software_fj.py --version  -> muestra la versión
    """
    configurar_consola()
    argumentos = list(sys.argv[1:] if argv is None else argv)

    if "--version" in argumentos or "-v" in argumentos:
        print(f"{NOMBRE_EMPRESA} v{VERSION_PROGRAMA}")
        return 0

    mostrar_banner()

    # El logger nunca lanza excepciones: si falla, el programa sigue.
    registro = RegistroEventos()
    sistema = SistemaGestionFJ(registro)

    print(f"  Archivo de logs: {registro.ruta_archivo}")
    if not registro.archivo_operativo:
        print("  [AVISO] No se pudo crear el archivo de logs.")
        print("  Los eventos se mostrarán en pantalla y se guardarán en memoria.")
    print(SEPARADOR)

    # Lectura de los argumentos de la línea de comandos.
    modo_demo = any(
        argumento.lower() in ("--demo", "-d", "demo") for argumento in argumentos
    )
    modo_consola = any(
        argumento.lower() in ("--consola", "-c", "consola")
        for argumento in argumentos
    )

    try:
        if modo_demo:
            # Demostración sin interacción: ideal para generar evidencias.
            sistema.ejecutar_demostracion()
        elif modo_consola:
            # Menú de texto solicitado explícitamente.
            bucle_principal(sistema)
        elif not iniciar_interfaz_grafica(sistema):
            # Si no hay Tkinter o no hay pantalla, se usa la consola.
            print("  Iniciando la interfaz de consola...")
            bucle_principal(sistema)
    except SalidaSolicitada:
        print("\n  Entrada finalizada. Cerrando el sistema...")
        registro.advertencia("Ejecución finalizada por fin de la entrada estándar.")
    except KeyboardInterrupt:
        print("\n  Interrupción detectada (Ctrl+C). Cerrando el sistema...")
        registro.advertencia("Ejecución interrumpida por el usuario (Ctrl+C).")
    except Exception as error:
        # Cualquier error no previsto se registra y se informa sin mostrar
        # una traza técnica al usuario final.
        registro.critico("Error no controlado durante la ejecución.", error)
        print("\n  [X] Ocurrió un error inesperado. Revise el archivo de logs.")
        return 1
    finally:
        # Pase lo que pase, se deja constancia del cierre en el log.
        try:
            sistema.cerrar()
        except Exception:
            pass

    print("\n  Gracias por usar Software FJ.\n")
    return 0


# Esta condición garantiza que el programa solo se ejecute si es el archivo
# principal, y no cuando se importe desde otro módulo (útil para pruebas).
if __name__ == "__main__":
    sys.exit(main())
