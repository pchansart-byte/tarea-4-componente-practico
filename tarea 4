    def _demo_paso(self, numero: int, descripcion: str,
                   accion: Callable[[], str]) -> str:
        """Ejecuta un paso de la demostración y clasifica el resultado."""
        # Un fallo de ErrorSistemaFJ es esperado; uno de Exception no lo es.
        print(f"\n[{numero:02d}] {descripcion}")
        try:
            detalle = accion()
        except ErrorSistemaFJ as error:
            # Se registra como advertencia y se muestra la causa encadenada.
            self._registro.advertencia(
                f"DEMO {numero:02d} | fallo controlado | "
                f"{type(error).__name__}: {error}")
            print("     RESULTADO: fallo controlado")
            print(f"     Excepción: {type(error).__name__}: {error}")
            if error.__cause__ is not None:
                print(f"     Encadenada: {type(error.__cause__).__name__}: "
                      f"{error.__cause__}")
            return "CONTROLADO"
        except Exception as error:
            # Un error técnico sí indica un problema que debe revisarse.
            self._registro.critico(f"DEMO {numero:02d} | error", error)
            print(f"     RESULTADO: error no controlado -> {error}")
            return "INESPERADO"
        else:
            self._registro.info(f"DEMO {numero:02d} | exitoso | {detalle}")
            print("     RESULTADO: OK")
            print(f"     Detalle: {detalle}")
            return "OK"
        finally:
            # El separador se imprime siempre, haya éxito o error.
            print(f"     {SUBSECCION[:60]}")

