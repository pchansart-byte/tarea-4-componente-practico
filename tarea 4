    # --------------------------- AYUDAS DE UI -------------------------------
    def _crear_campo(self, padre, fila: int, texto: str, variable,
                     ancho: int = 26):
        """Crea una etiqueta y un Entry en una fila."""
        ttk.Label(padre, text=texto).grid(row=fila, column=0, sticky="w", pady=3)
        entrada = ttk.Entry(padre, textvariable=variable, width=ancho)
        entrada.grid(row=fila, column=1, sticky="ew", pady=3)
        return entrada

    def _crear_combo(self, padre, fila: int, texto: str, variable,
                     valores, ancho: int = 24):
        """Crea una etiqueta y un Combobox de solo lectura."""
        ttk.Label(padre, text=texto).grid(row=fila, column=0, sticky="w", pady=3)
        combo = ttk.Combobox(
            padre, textvariable=variable, values=valores,
            state="readonly", width=ancho,
        )
        combo.grid(row=fila, column=1, sticky="ew", pady=3)
        return combo

    def _crear_tabla(self, padre, columnas, anchos, alto: int = 14):
        """Crea un Treeview con barra vertical y columnas."""
        # "columnas" trae pares (clave, título); "anchos" el ancho de cada una.
        tabla = ttk.Treeview(
            padre, columns=[c for c, _ in columnas],
            show="headings", height=alto,
        )
        for (clave, titulo), ancho in zip(columnas, anchos):
            tabla.heading(clave, text=titulo, anchor="w")
            tabla.column(clave, width=ancho, minwidth=50, anchor="w", stretch=True)
        # La barra vertical permite recorrer listas largas.
        barra = ttk.Scrollbar(padre, orient="vertical", command=tabla.yview)
        tabla.configure(yscrollcommand=barra.set)
        tabla.grid(row=0, column=0, sticky="nsew")
        barra.grid(row=0, column=1, sticky="ns")
        return tabla

    @staticmethod
    def _recortar(texto: object, maximo: int = 32) -> str:
        """Recorta textos largos para las columnas de las tablas."""
        # Evita que un nombre largo desborde la celda; agrega puntos suspensivos.
        cadena = str(texto)
        return cadena if len(cadena) <= maximo else cadena[:maximo - 1].rstrip() + "…"

