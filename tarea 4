# SECCIÓN 5. UTILIDADES DE VALIDACIÓN Y FORMATO
# Estas funciones se usan dentro de las clases. Centralizarlas evita repetir
# validaciones y garantiza que todos los datos se revisen igual.

# Documento: solo dígitos, entre 6 y 12 (cédula o NIT).
PATRON_DOCUMENTO = re.compile(r"^\d{6,12}$")

# Correo: estructura básica usuario@dominio.extension.
PATRON_CORREO = re.compile(r"^[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}$")

# Nombre de persona: letras, espacios, apóstrofos, puntos y guiones.
PATRON_NOMBRE_PERSONA = re.compile(r"^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ' .\-]{2,60}$")

# Razón social: además permite números, comas y ampersand (Ej: "S.A.S.").
PATRON_RAZON_SOCIAL = re.compile(r"^[A-Za-z0-9ÁÉÍÓÚÜÑáéíóúüñ' .,&\-]{2,60}$")


def redondear(valor: Decimal) -> Decimal:
    """Redondea un valor monetario a dos decimales con redondeo comercial."""
    # ROUND_HALF_UP redondea 0.005 hacia arriba, como se espera en dinero.
    return valor.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)

def formatear_moneda(valor: Decimal) -> str:
    """Convierte 1234567.5 en "$1.234.567,50" (formato colombiano)."""
    # Se usa formato inglés y luego se intercambian coma y punto.
    texto = f"{valor:,.2f}"                                  # 1,234,567.50
    texto = texto.replace(",", "X").replace(".", ",").replace("X", ".")
    return f"${texto}"

def formatear_fecha(valor: datetime) -> str:
    """Devuelve una fecha legible: 25/11/2026 14:30."""
    return valor.strftime(FORMATO_FECHA)

def formatear_porcentaje(tasa: Decimal) -> str:
    """Convierte la fracción 0.19 en el texto '19.00%'."""
    return f"{(tasa * 100).quantize(Decimal('0.01'))}%"

def limpiar_texto(
    valor: object,
    campo: str,
    longitud_maxima: int = 80,
    obligatorio: bool = True,
) -> str:
    """Limpia espacios y valida que el texto no esté vacío ni sea demasiado largo."""
    # Todo valor que no sea texto se rechaza de inmediato.
    if not isinstance(valor, str):
        raise DatosInvalidosError(f"El campo '{campo}' debe ser texto.")
    # split() y join() quitan espacios dobles y de los extremos.
    texto = " ".join(valor.split())
    if not texto:
        if obligatorio:
            raise DatosInvalidosError(f"El campo '{campo}' no puede estar vacío.")
        return ""
    if len(texto) > longitud_maxima:
        raise DatosInvalidosError(
            f"El campo '{campo}' no puede superar {longitud_maxima} caracteres."
        )
    return texto

def validar_documento(valor: object) -> str:
    """Valida y normaliza un documento de identidad (solo dígitos)."""
    # Si llega como entero se convierte a texto; un booleano no es válido.
    if isinstance(valor, int) and not isinstance(valor, bool):
        valor = str(valor)
    if not isinstance(valor, str):
        raise DatosInvalidosError("El documento debe contener solo dígitos.")
    # Se aceptan puntos y espacios de separación: 1.023.456 -> 1023456.
    documento = valor.strip().replace(".", "").replace(" ", "")
    if not PATRON_DOCUMENTO.match(documento):
        raise DatosInvalidosError(
            "El documento debe tener entre 6 y 12 dígitos numéricos."
        )
    return documento

def validar_nombre(valor: object, campo: str, permitir_numeros: bool = False) -> str:
    """Valida nombres de personas o razones sociales."""
    # Las empresas pueden tener números y puntos; las personas no.
    texto = limpiar_texto(valor, campo, longitud_maxima=60)
    patron = PATRON_RAZON_SOCIAL if permitir_numeros else PATRON_NOMBRE_PERSONA
    if not patron.match(texto):
        raise DatosInvalidosError(
            f"El campo '{campo}' contiene caracteres no permitidos o es demasiado corto."
        )
    # Se exige al menos dos letras reales para evitar nombres como "1 2".
    letras = re.sub(r"[^A-Za-zÁÉÍÓÚÜÑáéíóúüñ]", "", texto)
    if len(letras) < 2:
        raise DatosInvalidosError(f"El campo '{campo}' debe contener al menos dos letras.")
    return texto

def validar_correo(valor: object) -> str:
    """Valida el correo electrónico y lo guarda en minúsculas."""
    if not isinstance(valor, str):
        raise DatosInvalidosError("El correo electrónico debe ser texto.")
    correo = valor.strip().lower()
    if len(correo) > 80 or not PATRON_CORREO.match(correo):
        raise DatosInvalidosError(
            f"El correo electrónico '{valor}' no es válido. Ejemplo: nombre@dominio.com"
        )
    return correo

def validar_telefono(valor: object) -> str:
    """Valida un teléfono de 7 a 10 dígitos y descarta separadores."""
    if isinstance(valor, int) and not isinstance(valor, bool):
        valor = str(valor)
    if not isinstance(valor, str):
        raise DatosInvalidosError("El teléfono debe contener solo dígitos.")

    limpio = re.sub(r"[\s\-().+]", "", valor)

    if len(limpio) == 12 and limpio.startswith("57"):
        limpio = limpio[2:]
    if not re.fullmatch(r"\d{7,10}", limpio):
        raise DatosInvalidosError("El teléfono debe tener entre 7 y 10 dígitos.")
    return limpio

def convertir_entero(
    valor: object,
    campo: str,
    minimo: Optional[int] = None,
    maximo: Optional[int] = None,
) -> int:
    """Convierte y valida un número entero dentro de un rango."""
    # Un booleano es un entero en Python, pero no debe aceptarse aquí.
    if isinstance(valor, bool):
        raise DatosInvalidosError(f"El campo '{campo}' debe ser un número entero.")
    try:
        if isinstance(valor, int):
            numero = valor
        elif isinstance(valor, str):
            texto = valor.strip()
            # Solo se aceptan dígitos con signo opcional, sin decimales.
            if not re.fullmatch(r"[+-]?\d+", texto):
                raise ValueError("formato no entero")
            numero = int(texto)
        else:
            numero = int(valor)  # type: ignore[arg-type]
    except (TypeError, ValueError) as error:
        # Se conserva la causa técnica mediante encadenamiento.
        raise DatosInvalidosError(
            f"El campo '{campo}' debe ser un número entero. Se recibió: {valor!r}."
        ) from error
    # Validación del rango mínimo y máximo.
    if minimo is not None and numero < minimo:
        raise DatosInvalidosError(f"El campo '{campo}' debe ser mayor o igual a {minimo}.")
    if maximo is not None and numero > maximo:
        raise DatosInvalidosError(f"El campo '{campo}' debe ser menor o igual a {maximo}.")
    return numero

def convertir_decimal(
    valor: object,
    campo: str,
    minimo: Optional[Decimal] = None,
    maximo: Optional[Decimal] = None,
) -> Decimal:
    """Convierte un valor a Decimal y valida su rango."""
    if valor is None:
        raise DatosInvalidosError(f"El campo '{campo}' es obligatorio.")
    if isinstance(valor, bool):
        raise DatosInvalidosError(f"El campo '{campo}' debe ser numérico.")
    try:
        if isinstance(valor, Decimal):
            numero = valor
        else:
            # Se acepta coma decimal y se eliminan espacios.
            texto = str(valor).strip().replace(" ", "").replace(",", ".")
            if not texto:
                raise InvalidOperation("texto vacío")
            numero = Decimal(texto)
    except (InvalidOperation, ValueError) as error:
        raise DatosInvalidosError(
            f"El campo '{campo}' debe ser numérico. Se recibió: {valor!r}."
        ) from error
    # is_finite() rechaza NaN e infinito, que romperían los cálculos.
    if not numero.is_finite():
        raise DatosInvalidosError(f"El campo '{campo}' no es un número válido.")
    if minimo is not None and numero < minimo:
        raise DatosInvalidosError(f"El campo '{campo}' debe ser mayor o igual a {minimo}.")
    if maximo is not None and numero > maximo:
        raise DatosInvalidosError(f"El campo '{campo}' debe ser menor o igual a {maximo}.")
    return numero

def enmascarar(texto: str, visibles: int = 2) -> str:
    """Oculta la parte central de un dato personal."""
    # Ejemplo: "10234567" -> "10****67"; se conservan los extremos.
    if len(texto) <= visibles * 2:
        return "*" * len(texto)
    return f"{texto[:visibles]}{'*' * (len(texto) - visibles * 2)}{texto[-visibles:]}"

# SECCIÓN 6. REGISTRO DE EVENTOS (ARCHIVO DE LOGS)
class RegistroEventos:
    """
    Escribe eventos en un archivo de texto y nunca detiene la aplicación.

    El archivo se trunca al iniciar cada ejecución del programa. Si no se
    puede escribir en la carpeta del programa, se prueban la carpeta del
    usuario y la temporal; si todas fallan, los eventos quedan en memoria.
    """
    MAXIMO_BUFFER = 200

    # Bandera de proceso: solo el primer registro de esta ejecución limpia el
    # archivo. Las instancias siguientes (por ejemplo, la demo) solo agregan.
    _log_iniciado = False

    def __init__(self, nombre_archivo: str = "software_fj.log",
                 reiniciar: bool = True) -> None:
        """Prepara el archivo y el búfer de eventos."""
        self._nombre_archivo = nombre_archivo
        self._ruta: Optional[Path] = None
        self._archivo_operativo = False
        self._buffer: List[str] = []
        self._aviso_mostrado = False
        # Solo se reinicia si es la primera instancia del proceso.
        self._reiniciar = reiniciar and not RegistroEventos._log_iniciado
        self._preparar_archivo()

    @property
    def ruta_archivo(self) -> str:
        """Ruta del log o texto alternativo si no está disponible."""
        return str(self._ruta) if self._ruta is not None else "(no disponible)"

    @property
    def archivo_operativo(self) -> bool:
        """Indica si el archivo de logs se pudo abrir."""
        return self._archivo_operativo

    @property
    def eventos_en_memoria(self) -> int:
        """Cantidad de eventos guardados en memoria."""
        return len(self._buffer)

    def _preparar_archivo(self) -> None:
        """Busca una carpeta escribible y trunca el log al iniciar."""
        # Se intenta primero junto al programa y luego en ubicaciones de respaldo.
        try:
            base = Path(__file__).resolve().parent
        except NameError:
            base = Path.cwd()
        carpetas = (
            base / "logs",
            Path.home() / "SoftwareFJ" / "logs",
            Path(tempfile.gettempdir()) / "software_fj" / "logs",
        )
        for carpeta in carpetas:
            try:
                carpeta.mkdir(parents=True, exist_ok=True)
                ruta = carpeta / self._nombre_archivo
                nuevo = not ruta.exists() or ruta.stat().st_size == 0
                # "w" trunca al iniciar la ejecución; "a" agrega en instancias
                # posteriores para no borrar eventos en caliente.
                modo = "w" if self._reiniciar else "a"
                with ruta.open(modo, encoding="utf-8") as archivo:
                    if self._reiniciar or nuevo:
                        archivo.write(SEPARADOR + "\n")
                        archivo.write(
                            f"REGISTRO DE EVENTOS - {NOMBRE_EMPRESA} "
                            f"v{VERSION_PROGRAMA}\n")
                        archivo.write(
                            "Inicio de ejecución: "
                            f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
                        archivo.write(SEPARADOR + "\n")
                self._ruta = ruta
                self._archivo_operativo = True
                if self._reiniciar:
                    RegistroEventos._log_iniciado = True
                return
            except OSError:
                # Esta carpeta no sirve; se prueba la siguiente.
                continue
        self._archivo_operativo = False

    def _escribir(self, bloque: str) -> bool:
        """Escribe un bloque de texto en el archivo."""
        if not self._archivo_operativo or self._ruta is None:
            return False
        try:
            # Se abre y cierra en cada escritura para no dejar el archivo bloqueado.
            with self._ruta.open("a", encoding="utf-8") as archivo:
                archivo.write(bloque + "\n")
        except OSError:
            self._archivo_operativo = False
            self._avisar_una_vez()
            return False
        return True

    def _avisar_una_vez(self) -> None:
        """Avisa una sola vez si falla la escritura del log."""
        if not self._aviso_mostrado:
            self._aviso_mostrado = True
            print("[AVISO] No se pudo escribir el log; se guardará en memoria.",
                  file=sys.stderr)

    def _guardar_en_buffer(self, bloque: str) -> None:
        """Guarda un evento en memoria cuando falla el archivo."""
        self._buffer.append(bloque)
        # Se conservan solo los últimos eventos para no crecer sin límite.
        if len(self._buffer) > self.MAXIMO_BUFFER:
            self._buffer.pop(0)

    def registrar(self, nivel: str, mensaje: str,
                  excepcion: Optional[BaseException] = None) -> None:
        """Registra un evento; en errores agrega la traza completa."""
        try:
            # Formato: fecha | nivel | mensaje.
            linea = (f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')} | "
                     f"{nivel:<11} | {mensaje}")
            if excepcion is not None:
                linea += f" | {type(excepcion).__name__}: {excepcion}"
            lineas = [linea]
            # En ERROR y CRITICO se guarda también el traceback, que incluye
            # la cadena de excepciones encadenadas con raise ... from ...
            if excepcion is not None and nivel in ("ERROR", "CRITICO"):
                traza = traceback.format_exception(
                    type(excepcion), excepcion, excepcion.__traceback__)
                for fragmento in "".join(traza).rstrip().splitlines():
                    lineas.append("    " + fragmento)
            bloque = "\n".join(lineas)
            if not self._escribir(bloque):
                self._guardar_en_buffer(bloque)
        except Exception:
            # Última red de seguridad: el log nunca debe romper la aplicación.
            print(f"[LOG] {nivel}: {mensaje}", file=sys.stderr)

    def info(self, mensaje: str) -> None:
        """Registra un evento informativo."""
        self.registrar("INFO", mensaje)

    def advertencia(self, mensaje: str) -> None:
        """Registra una advertencia."""
        self.registrar("ADVERTENCIA", mensaje)

    def error(self, mensaje: str,
              excepcion: Optional[BaseException] = None) -> None:
        """Registra un error controlado."""
        self.registrar("ERROR", mensaje, excepcion)

    def critico(self, mensaje: str,
                excepcion: Optional[BaseException] = None) -> None:
        """Registra un error crítico."""
        self.registrar("CRITICO", mensaje, excepcion)

# SECCIÓN 7. ENTIDAD ABSTRACTA DEL SISTEMA
class EntidadSistema(ABC):
    """
    Clase abstracta para todas las entidades del sistema.

    Define el contrato común: identificador, fecha de creación, descripción y
    validación. No se instancia directamente; Cliente, Servicio y Reserva
    heredan de ella y completan las reglas propias.
    """
    PREFIJO_ID = "ENT"

    # Cada clase hija redefine su propio contador para que los IDs avancen
    # de forma independiente (CLI-0001, RES-0001, etc.).
    _contador = itertools.count(1)

    def __init__(self, identificador: Optional[str] = None) -> None:
        """Asigna identificador y fecha de creación."""
        # Si no se recibe identificador, se genera uno automático.
        self._id = self._construir_id(identificador)
        self._fecha_creacion = datetime.now()

    @classmethod
    def _construir_id(cls, identificador: Optional[str]) -> str:
        """Genera un ID automático o normaliza el recibido."""
        if identificador is None:
            numero = next(cls._contador)
            return f"{cls.PREFIJO_ID}-{numero:04d}"
        # El identificador recibido se limpia y se guarda en mayúsculas.
        texto = limpiar_texto(identificador, "identificador", longitud_maxima=20)
        return texto.upper()

    # ------------------------------ PROPIEDADES -----------------------------
    @property
    def id(self) -> str:
        """Identificador único de la entidad (solo lectura)."""
        return self._id

    @property
    def fecha_creacion(self) -> datetime:
        """Momento exacto en que se creó la entidad."""
        return self._fecha_creacion

    # ------------------------- MÉTODOS ABSTRACTOS ---------------------------
    @abstractmethod
    def describir(self) -> str:
        """Devuelve una ficha legible de la entidad (varias líneas)."""
        raise NotImplementedError  # las clases hijas están obligadas a implementarlo

    @abstractmethod
    def _validar_reglas_propias(self) -> None:
        """Valida las reglas específicas de la subclase."""
        raise NotImplementedError

    # ------------------------ MÉTODOS CONCRETOS -----------------------------
    def validar(self) -> bool:
        """Valida la entidad completa."""
        # Este es un método plantilla: valida lo común y delega lo específico.
        if not isinstance(self._id, str) or not self._id.strip():
            raise DatosInvalidosError("La entidad no tiene un identificador válido.")
        if not isinstance(self._fecha_creacion, datetime):
            raise DatosInvalidosError("La fecha de creación de la entidad no es válida.")
        self._validar_reglas_propias()
        return True

    # ---------------------- MÉTODOS ESPECIALES (DUNDER) ---------------------
    def __str__(self) -> str:
        """Representación corta de la entidad."""
        return f"{self._id}"

    def __repr__(self) -> str:
        """Representación técnica para depuración."""
        return f"<{type(self).__name__} id={self._id!r}>"

    def __eq__(self, otro: object) -> bool:
        """Compara entidades por tipo e identificador."""
        if not isinstance(otro, EntidadSistema):
            return NotImplemented
        return type(self) is type(otro) and self._id == otro._id

    def __hash__(self) -> int:
        """Permite usar entidades en conjuntos y diccionarios."""
        return hash((type(self).__name__, self._id))

# SECCIÓN 8. CLIENTE
class TipoCliente(Enum):
    """Tipos de cliente que atiende Software FJ."""
    NATURAL = "Persona natural"
    EMPRESA = "Empresa"

class Cliente(EntidadSistema):
    """
    Cliente de Software FJ con encapsulación y validaciones.

    Los datos se guardan en atributos privados y solo se modifican mediante
    propiedades. Cada setter valida el dato antes de asignarlo, de modo que un
    cliente nunca queda con un correo, documento o teléfono inválido.
    """
    PREFIJO_ID = "CLI"
    _contador = itertools.count(1)

    def __init__(
        self,
        documento: object,
        nombre: object,
        apellido: object,
        correo: object,
        telefono: object,
        direccion: object = "",
        tipo: TipoCliente = TipoCliente.NATURAL,
    ) -> None:
        """Valida y guarda los datos personales del cliente."""
        super().__init__()
        # Cada dato pasa por su validador antes de guardarse.
        self._documento = validar_documento(documento)
        # El tipo se asigna antes de los nombres porque las reglas de nombre
        # cambian entre persona natural y empresa.
        self._tipo = TipoCliente.NATURAL
        self.tipo = tipo
        self._nombre = validar_nombre(
            nombre, "nombre", permitir_numeros=self._tipo is TipoCliente.EMPRESA
        )
        self._apellido = validar_nombre(
            apellido, "apellido o razón social",
            permitir_numeros=self._tipo is TipoCliente.EMPRESA,
        )
        self._correo = validar_correo(correo)
        self._telefono = validar_telefono(telefono)
        self._direccion = limpiar_texto(
            direccion, "dirección", longitud_maxima=100, obligatorio=False
        )
        # Todo cliente nuevo está activo y sin motivo de inactivación.
        self._activo = True
        self._motivo_inactividad = ""

    # ------------------------- PROPIEDADES (GET/SET) ------------------------
    @property
    def documento(self) -> str:
        """Documento completo (dato sensible: no se muestra en listados)."""
        return self._documento

    @documento.setter
    def documento(self, valor: object) -> None:
        """Documento de identidad del cliente."""
        self._documento = validar_documento(valor)

    @property
    def nombre(self) -> str:
        """Nombre del cliente o razón social."""
        return self._nombre

    @nombre.setter
    def nombre(self, valor: object) -> None:
        """Nombre del cliente o razón social."""
        self._nombre = validar_nombre(
            valor, "nombre", permitir_numeros=self._tipo is TipoCliente.EMPRESA
        )

    @property
    def apellido(self) -> str:
        """Apellido o departamento del cliente."""
        return self._apellido

    @apellido.setter
    def apellido(self, valor: object) -> None:
        """Apellido o departamento del cliente."""
        self._apellido = validar_nombre(
            valor, "apellido o razón social",
            permitir_numeros=self._tipo is TipoCliente.EMPRESA,
        )

    @property
    def correo(self) -> str:
        """Correo electrónico del cliente."""
        return self._correo

    @correo.setter
    def correo(self, valor: object) -> None:
        """Correo electrónico del cliente."""
        self._correo = validar_correo(valor)

    @property
    def telefono(self) -> str:
        """Teléfono del cliente."""
        return self._telefono

    @telefono.setter
    def telefono(self, valor: object) -> None:
        """Teléfono del cliente."""
        self._telefono = validar_telefono(valor)

    @property
    def direccion(self) -> str:
        """Dirección del cliente."""
        return self._direccion

    @direccion.setter
    def direccion(self, valor: object) -> None:
        """Dirección del cliente."""
        self._direccion = limpiar_texto(
            valor, "dirección", longitud_maxima=100, obligatorio=False
        )

    @property
    def tipo(self) -> TipoCliente:
        """Tipo de cliente: natural o empresa."""
        return self._tipo

    @tipo.setter
    def tipo(self, valor: object) -> None:
        """Tipo de cliente: natural o empresa."""
        if isinstance(valor, TipoCliente):
            self._tipo = valor
            return
        if isinstance(valor, str):
            try:
                self._tipo = TipoCliente[valor.strip().upper()]
                return
            except KeyError as error:

                raise DatosInvalidosError(
                    f"Tipo de cliente no válido: '{valor}'. Use NATURAL o EMPRESA."
                ) from error
        raise DatosInvalidosError("El tipo de cliente debe ser NATURAL o EMPRESA.")

    @property
    def activo(self) -> bool:
        """Indica si el cliente puede reservar."""
        return self._activo

    @activo.setter
    def activo(self, valor: object) -> None:
        """Indica si el cliente puede reservar."""
        if not isinstance(valor, bool):
            raise DatosInvalidosError("El estado 'activo' debe ser verdadero o falso.")
        self._activo = valor

    @property
    def motivo_inactividad(self) -> str:
        """Motivo por el cual el cliente está inactivo."""
        return self._motivo_inactividad

    # ------------------------------ UTILIDADES ------------------------------
    def nombre_completo(self) -> str:
        """Une nombre y apellido en un solo texto."""
        return f"{self._nombre} {self._apellido}".strip()

    def documento_mascarado(self) -> str:
        """Documento con la parte central oculta (privacidad)."""
        return enmascarar(self._documento)

    def correo_mascarado(self) -> str:
        """Correo con usuario y dominio parcialmente ocultos."""
        # Se ocultan el usuario y la parte principal del dominio, pero se deja
        # la extensión (.com, .co, etc.) para que el dato siga siendo legible.
        if "@" not in self._correo:
            return enmascarar(self._correo)
        usuario, dominio = self._correo.split("@", 1)
        punto = dominio.rfind(".")
        if punto <= 0:
            return f"{enmascarar(usuario)}@{enmascarar(dominio)}"
        return f"{enmascarar(usuario)}@{enmascarar(dominio[:punto])}{dominio[punto:]}"

    def telefono_mascarado(self) -> str:
        """Teléfono con la parte central oculta."""
        return enmascarar(self._telefono)

    def activar(self) -> None:
        """Reactiva al cliente para que pueda volver a reservar."""
        self._activo = True
        self._motivo_inactividad = ""

    def desactivar(self, motivo: str = "") -> None:
        """Inactiva al cliente y guarda el motivo (no podrá reservar)."""
        # Un cliente inactivo no puede crear reservas nuevas.
        self._activo = False
        self._motivo_inactividad = limpiar_texto(
            motivo, "motivo de inactivación", longitud_maxima=150, obligatorio=False
        )

    # --------------------- IMPLEMENTACIÓN DE LA BASE ------------------------
    def describir(self) -> str:
        """Ficha del cliente con los datos personales enmascarados."""
        # Se usa enmascaramiento para no exponer datos sensibles en listados.
        estado = "Activo" if self._activo else "Inactivo"
        if not self._activo and self._motivo_inactividad:
            estado += f" ({self._motivo_inactividad})"
        return (
            f"Cliente {self.id} | {self.nombre_completo()}\n"
            f"   Documento: {self.documento_mascarado()} | Tipo: {self._tipo.value}\n"
            f"   Correo: {self.correo_mascarado()} | Teléfono: {self.telefono_mascarado()}\n"
            f"   Dirección: {self._direccion or '(sin dirección)'}\n"
            f"   Estado: {estado} | Registrado: {formatear_fecha(self._fecha_creacion)}"
        )

    def _validar_reglas_propias(self) -> None:
        """Revalida todos los datos del cliente."""
        # Se vuelven a ejecutar los validadores por si algún setter cambió.
        validar_documento(self._documento)
        validar_nombre(
            self._nombre, "nombre", permitir_numeros=self._tipo is TipoCliente.EMPRESA
        )
        validar_nombre(
            self._apellido, "apellido o razón social",
            permitir_numeros=self._tipo is TipoCliente.EMPRESA,
        )
        validar_correo(self._correo)
        validar_telefono(self._telefono)
        if not isinstance(self._activo, bool):
            raise DatosInvalidosError("El estado del cliente no es válido.")

    def __str__(self) -> str:
        """Resumen corto del cliente."""
        return (
            f"{self.id} - {self.nombre_completo()} "
            f"({self.documento_mascarado()})"
        )

# SECCIÓN 9. SERVICIOS (CLASE ABSTRACTA Y TRES ESPECIALIZACIONES)
class Servicio(EntidadSistema, ABC):
    """
    Clase abstracta para los servicios de Software FJ.

    Define los datos comunes (código, nombre, tarifa, disponibilidad), el
    cálculo general de costos y la sobrecarga de calcular_costo(). Cada
    servicio especializado redefine la forma de calcular su subtotal y sus
    propios rangos de cantidad.
    """

    UNIDAD_MEDIDA = "unidad"
    UNIDAD_PLURAL = "unidades"
    HORAS_POR_UNIDAD = Decimal("1")
    CANTIDAD_MINIMA = Decimal("1")
    CANTIDAD_MAXIMA = Decimal("8")

    def __init__(
        self,
        codigo: object,
        nombre: object,
        tarifa_base: object,
        disponible: bool = True,
    ) -> None:
        """Valida el código, nombre, tarifa y disponibilidad."""
        # El código es obligatorio y lo escribe el usuario: no se genera solo.
        if codigo is None or not str(codigo).strip():
            raise DatosInvalidosError("El código del servicio es obligatorio.")
        super().__init__(str(codigo))
        self._nombre = limpiar_texto(nombre, "nombre del servicio", longitud_maxima=70)
        # La tarifa debe ser positiva para que el costo final sea válido.
        self._tarifa_base = convertir_decimal(
            tarifa_base, "tarifa base", minimo=Decimal("0.01"),
            maximo=Decimal("100000000"),
        )
        if not isinstance(disponible, bool):
            raise DatosInvalidosError("La disponibilidad del servicio debe ser lógica.")
        self._disponible = disponible
        self._motivo_no_disponible = ""

    # ------------------------------ PROPIEDADES -----------------------------
    @property
    def codigo(self) -> str:
        """Código único del servicio (coincide con su ID)."""
        return self._id

    @property
    def nombre(self) -> str:
        """Nombre del servicio."""
        return self._nombre

    @nombre.setter
    def nombre(self, valor: object) -> None:
        """Nombre del servicio."""
        self._nombre = limpiar_texto(valor, "nombre del servicio", longitud_maxima=70)

    @property
    def tarifa_base(self) -> Decimal:
        """Valor de una unidad de servicio (una hora o un día)."""
        return self._tarifa_base

    @tarifa_base.setter
    def tarifa_base(self, valor: object) -> None:
        """Valor de una unidad de servicio."""
        self._tarifa_base = convertir_decimal(
            valor, "tarifa base", minimo=Decimal("0.01"),
            maximo=Decimal("100000000"),
        )

    @property
    def disponible(self) -> bool:
        """Indica si el servicio puede reservarse."""
        return self._disponible

    @property
    def motivo_no_disponible(self) -> str:
        """Motivo por el cual el servicio está bloqueado."""
        return self._motivo_no_disponible

    @property
    def unidad_medida(self) -> str:
        """Singular de la unidad: 'hora' o 'día'."""
        return self.UNIDAD_MEDIDA

    @property
    def unidad_plural(self) -> str:
        """Plural de la unidad, para textos como '3 horas'."""
        return self.UNIDAD_PLURAL

    @property
    def cantidad_minima(self) -> Decimal:
        """Cantidad mínima que se puede reservar."""
        return self.CANTIDAD_MINIMA

    @property
    def cantidad_maxima(self) -> Decimal:
        """Cantidad máxima que se puede reservar."""
        return self.CANTIDAD_MAXIMA

    # -------------------------- DISPONIBILIDAD ------------------------------
    def verificar_disponibilidad(self) -> None:
        """Lanza ServicioNoDisponibleError si el servicio está bloqueado."""
        if not self._disponible:
            detalle = (
                f" Motivo: {self._motivo_no_disponible}."
                if self._motivo_no_disponible else ""
            )
            raise ServicioNoDisponibleError(
                f"El servicio {self.codigo} ({self._nombre}) no está disponible.{detalle}"
            )

    def marcar_no_disponible(self, motivo: str = "") -> None:
        """Bloquea temporalmente el servicio (mantenimiento, por ejemplo)."""
        self._disponible = False
        self._motivo_no_disponible = limpiar_texto(
            motivo, "motivo", longitud_maxima=150, obligatorio=False
        )

    def marcar_disponible(self) -> None:
        """Vuelve a habilitar el servicio."""
        self._disponible = True
        self._motivo_no_disponible = ""

    # --------------------- VALIDACIÓN Y CÁLCULO DE COSTOS -------------------
    def validar_parametros(self, cantidad: object) -> Decimal:
        """Convierte la cantidad de unidades y valida el rango general."""
        valor = convertir_decimal(
            cantidad, f"cantidad de {self.unidad_plural}",
            minimo=self.CANTIDAD_MINIMA, maximo=self.CANTIDAD_MAXIMA,
        )
        return valor

    def _calcular_subtotal(self, cantidad: Decimal, **opciones: object) -> Decimal:
        """Calcula el subtotal base según la cantidad."""
        return self._tarifa_base * cantidad

    def _desglosar_costo(
        self,
        cantidad: Optional[object] = None,
        impuesto: Optional[object] = None,
        descuento: Optional[object] = None,
        **opciones: object,
    ) -> Dict[str, Decimal]:
        """Calcula subtotal, descuento, impuesto y total."""
        # Fórmula general:
        # subtotal = regla propia del servicio
        # descuento = subtotal * tasa_descuento
        # base = subtotal - descuento
        # impuesto = base * tasa_impuesto
        # total = base + impuesto
        cantidad = self.validar_parametros(
            self.CANTIDAD_MINIMA if cantidad is None else cantidad)
        tasa_impuesto = (
            IMPUESTO_IVA if impuesto is None else
            convertir_decimal(impuesto, "impuesto", Decimal("0"), TASA_MAXIMA))
        tasa_descuento = (
            Decimal("0") if descuento is None else
            convertir_decimal(descuento, "descuento", Decimal("0"), TASA_MAXIMA))
        subtotal = redondear(self._calcular_subtotal(cantidad, **opciones))
        valor_descuento = redondear(subtotal * tasa_descuento)
        base_gravable = redondear(subtotal - valor_descuento)
        valor_impuesto = redondear(base_gravable * tasa_impuesto)
        total = redondear(base_gravable + valor_impuesto)
        # Un total de cero o negativo indica un cálculo inconsistente.
        if total <= 0 or base_gravable < 0:
            raise CalculoInconsistenteError(
                f"Costo inválido para {self.codigo}: subtotal={subtotal}, "
                f"total={total}.")
        return {
            "cantidad": cantidad, "subtotal": subtotal,
            "descuento": valor_descuento, "base_gravable": base_gravable,
            "impuesto": valor_impuesto, "total": total,
            "tasa_impuesto": tasa_impuesto, "tasa_descuento": tasa_descuento,
        }

    # ------------------------- SOBRECARGA DE MÉTODOS ------------------------
    # Python no permite varias funciones con el mismo nombre, pero typing
    # permite declarar las variantes y una sola implementación con parámetros
    # opcionales. El usuario puede llamar:
    #   calcular_costo()
    #   calcular_costo(cantidad)
    #   calcular_costo(cantidad, impuesto)
    #   calcular_costo(cantidad, impuesto, descuento)
    @overload
    def calcular_costo(self) -> Decimal:
        """Variante 1: costo de una unidad con IVA por defecto."""

    @overload
    def calcular_costo(self, cantidad: Decimal) -> Decimal:
        """Variante 2: costo de N unidades con IVA por defecto."""

    @overload
    def calcular_costo(self, cantidad: Decimal, impuesto: Decimal) -> Decimal:
        """Variante 3: costo de N unidades con un impuesto indicado."""

    @overload
    def calcular_costo(
        self, cantidad: Decimal, impuesto: Decimal, descuento: Decimal
    ) -> Decimal:
        """Variante 4: costo de N unidades con impuesto y descuento."""

    def calcular_costo(
        self,
        cantidad: Optional[object] = None,
        impuesto: Optional[object] = None,
        descuento: Optional[object] = None,
        **opciones: object,
    ) -> Decimal:
        """Implementación única de las cuatro variantes sobrecargadas."""
        return self._desglosar_costo(cantidad, impuesto, descuento, **opciones)["total"]

    def calcular_detalle_costo(
        self,
        cantidad: Optional[object] = None,
        impuesto: Optional[object] = None,
        descuento: Optional[object] = None,
        **opciones: object,
    ) -> Dict[str, Decimal]:
        """Versión pública del desglose, útil para mostrar en pantalla."""
        return self._desglosar_costo(cantidad, impuesto, descuento, **opciones)

    # --------------------- IMPLEMENTACIÓN DE LA BASE ------------------------
    def describir(self) -> str:
        """Ficha general; las hijas agregan sus datos específicos."""
        if self._disponible:
            estado = "Disponible"
        else:
            estado = "No disponible"
            if self._motivo_no_disponible:
                estado += f" ({self._motivo_no_disponible})"
        return (
            f"Servicio {self.codigo} | {self._nombre}\n"
            f"   Tarifa base: {formatear_moneda(self._tarifa_base)} "
            f"por {self.unidad_medida}\n"
            f"   Estado: {estado}"
        )

    def _validar_reglas_propias(self) -> None:
        """Valida las reglas comunes de un servicio."""
        if not self._nombre:
            raise DatosInvalidosError(
                f"El servicio {self.codigo} no tiene nombre."
            )
        if self._tarifa_base <= 0:
            raise DatosInvalidosError(
                f"La tarifa del servicio {self.codigo} debe ser mayor que cero."
            )
        if not isinstance(self._disponible, bool):
            raise DatosInvalidosError(
                f"La disponibilidad del servicio {self.codigo} no es válida."
            )

    def __str__(self) -> str:
        """Resumen corto del servicio."""
        estado = "disponible" if self._disponible else "no disponible"
        return f"{self.codigo} - {self._nombre} ({estado})"

# SERVICIO 1: RESERVA DE SALAS
class TipoSala(Enum):
    """Tipos de sala y su factor de recargo sobre la tarifa base."""
    SALA_JUNTAS = "Sala de juntas"
    SALA_SISTEMAS = "Sala de sistemas"
    AUDITORIO = "Auditorio"

# Factores que multiplican la tarifa según el tipo de sala.
FACTOR_TIPO_SALA = {
    TipoSala.SALA_JUNTAS: Decimal("1.00"),
    TipoSala.SALA_SISTEMAS: Decimal("1.35"),
    TipoSala.AUDITORIO: Decimal("1.60"),
}

# Recargo por reservar en fin de semana (25%).
RECARGO_FIN_DE_SEMANA = Decimal("0.25")

# Recargo por equipamiento audiovisual incluido (10%).
RECARGO_EQUIPAMIENTO = Decimal("0.10")


class ReservaSalas(Servicio):
    """
    Servicio de reserva de salas por horas.

    Reglas:
    - Se cobra por horas completas, entre 1 y 8.
    - La tarifa se multiplica según el tipo de sala.
    - Si está equipada se suma un 10%.
    - Opcionalmente se aplica un recargo de fin de semana del 25%.
    """
    UNIDAD_MEDIDA = "hora"
    UNIDAD_PLURAL = "horas"
    HORAS_POR_UNIDAD = Decimal("1")
    CANTIDAD_MINIMA = Decimal("1")
    CANTIDAD_MAXIMA = Decimal("8")

    def __init__(
        self,
        codigo: object,
        nombre: object,
        tarifa_hora: object,
        tipo_sala: TipoSala,
        capacidad: object,
        equipada: bool = True,
        disponible: bool = True,
    ) -> None:
        """Valida tipo de sala, capacidad y equipamiento."""
        super().__init__(codigo, nombre, tarifa_hora, disponible)
        if not isinstance(tipo_sala, TipoSala):
            raise DatosInvalidosError("El tipo de sala no es válido.")
        self._tipo_sala = tipo_sala
        # La capacidad debe ser un entero entre 1 y 500 personas.
        self._capacidad = convertir_entero(capacidad, "capacidad", 1, 500)
        if not isinstance(equipada, bool):
            raise DatosInvalidosError("El campo 'equipada' debe ser lógico.")
        self._equipada = equipada

    # ------------------------------ PROPIEDADES -----------------------------
    @property
    def tipo_sala(self) -> TipoSala:
        """Tipo de sala reservada."""
        return self._tipo_sala

    @property
    def capacidad(self) -> int:
        """Capacidad máxima de personas."""
        return self._capacidad

    @property
    def equipada(self) -> bool:
        """Indica si incluye equipamiento audiovisual."""
        return self._equipada

    # ------------------------------ VALIDACIÓN ------------------------------
    def validar_parametros(self, cantidad: object) -> Decimal:
        """Sobrescritura: la sala solo se reserva por horas completas."""
        valor = super().validar_parametros(cantidad)
        if valor != valor.to_integral_value():
            raise DatosInvalidosError(
                "La sala solo se puede reservar por horas completas (1, 2, 3...)."
            )
        return valor

    # -------------------------------- COSTOS --------------------------------
    def _calcular_subtotal(
        self, cantidad: Decimal, recargo_fin_semana: bool = False
    ) -> Decimal:
        """Aplica factor de sala, equipamiento y recargo."""
        factor = FACTOR_TIPO_SALA[self._tipo_sala]
        subtotal = self._tarifa_base * cantidad * factor
        if self._equipada:
            subtotal *= (Decimal("1") + RECARGO_EQUIPAMIENTO)
        if recargo_fin_semana:
            subtotal *= (Decimal("1") + RECARGO_FIN_DE_SEMANA)
        return subtotal

    def calcular_costo(
        self,
        cantidad: Optional[object] = None,
        impuesto: Optional[object] = None,
        descuento: Optional[object] = None,
        recargo_fin_semana: bool = False,
    ) -> Decimal:
        """SOBRESCRITURA con un parámetro adicional (recargo de fin de semana)."""
        return super().calcular_costo(
            cantidad, impuesto, descuento,
            recargo_fin_semana=recargo_fin_semana,
        )

    # -------------------------------- FICHA ---------------------------------
    def describir(self) -> str:
        """Ficha completa del servicio de salas."""
        equipada = "Sí" if self._equipada else "No"
        return (
            super().describir()
            + f"\n   Tipo de sala: {self._tipo_sala.value} | "
              f"Capacidad: {self._capacidad} personas"
            + f"\n   Equipada: {equipada}"
        )

    def _validar_reglas_propias(self) -> None:
        """Valida los datos propios de una sala."""
        super()._validar_reglas_propias()
        if not isinstance(self._tipo_sala, TipoSala):
            raise DatosInvalidosError("El tipo de sala no es válido.")
        convertir_entero(self._capacidad, "capacidad", 1, 500)

# SERVICIO 2: ALQUILER DE EQUIPOS
class AlquilerEquipos(Servicio):
    """Servicio especializado: alquiler de equipos por días."""
    UNIDAD_MEDIDA = "día"
    UNIDAD_PLURAL = "días"
    HORAS_POR_UNIDAD = Decimal("24")
    CANTIDAD_MINIMA = Decimal("1")
    CANTIDAD_MAXIMA = Decimal("30")

    TASA_SEGURO = Decimal("0.08")
    TASA_DEPOSITO = Decimal("0.25")

    def __init__(
        self,
        codigo: object,
        nombre: object,
        tarifa_dia: object,
        equipo: object,
        marca: object = "",
        incluye_seguro: bool = False,
        disponible: bool = True,
    ) -> None:
        """Valida el equipo, la marca y el seguro."""
        super().__init__(codigo, nombre, tarifa_dia, disponible)
        self._equipo = limpiar_texto(equipo, "equipo", longitud_maxima=70)
        self._marca = limpiar_texto(
            marca, "marca", longitud_maxima=40, obligatorio=False
        )
        if not isinstance(incluye_seguro, bool):
            raise DatosInvalidosError("El campo 'incluye_seguro' debe ser lógico.")
        self._incluye_seguro = incluye_seguro

    # ------------------------------ PROPIEDADES -----------------------------
    @property
    def equipo(self) -> str:
        """Nombre del equipo alquilado."""
        return self._equipo

    @property
    def marca(self) -> str:
        """Marca del equipo."""
        return self._marca

    @property
    def incluye_seguro(self) -> bool:
        """Indica si el alquiler incluye seguro."""
        return self._incluye_seguro

    @property
    def deposito_garantia(self) -> Decimal:
        """Valor del depósito reembolsable que paga el cliente."""
        # El depósito es informativo y no forma parte del costo facturado.
        return redondear(self._tarifa_base * self.TASA_DEPOSITO)

    # ------------------------------ VALIDACIÓN ------------------------------
    def validar_parametros(self, cantidad: object) -> Decimal:
        """Sobrescritura: el alquiler se cobra por días completos."""
        valor = super().validar_parametros(cantidad)
        if valor != valor.to_integral_value():
            raise DatosInvalidosError(
                "El alquiler de equipos solo se cobra por días completos."
            )
        return valor

    # -------------------------------- COSTOS --------------------------------
    def _calcular_subtotal(
        self, cantidad: Decimal, incluir_seguro: Optional[bool] = None
    ) -> Decimal:
        """Calcula el subtotal del alquiler y el seguro."""
        # El seguro es un 8% adicional sobre el valor del alquiler.
        subtotal = self._tarifa_base * cantidad
        seguro = self._incluye_seguro if incluir_seguro is None else bool(incluir_seguro)
        if seguro:
            subtotal += subtotal * self.TASA_SEGURO
        return subtotal

    # -------------------------------- FICHA ---------------------------------
    def describir(self) -> str:
        """Ficha completa del alquiler de equipos."""
        seguro = "Sí" if self._incluye_seguro else "No"
        marca = self._marca or "(sin marca)"
        return (
            super().describir()
            + f"\n   Equipo: {self._equipo} | Marca: {marca}"
            + f"\n   Seguro incluido: {seguro} | "
              f"Depósito de garantía: {formatear_moneda(self.deposito_garantia)}"
        )

    def _validar_reglas_propias(self) -> None:
        """Valida los datos propios del alquiler."""
        super()._validar_reglas_propias()
        if not self._equipo:
            raise DatosInvalidosError("El alquiler debe indicar el equipo.")
        if not isinstance(self._incluye_seguro, bool):
            raise DatosInvalidosError("El campo 'incluye_seguro' no es válido.")

# SERVICIO 3: ASESORÍA ESPECIALIZADA
class NivelAsesor(Enum):
    """Nivel del asesor y su factor sobre la tarifa base."""
    JUNIOR = "Junior"
    SENIOR = "Senior"
    EXPERTO = "Experto"

# Factores de cobro según la experiencia del asesor.
FACTOR_NIVEL_ASESOR = {
    NivelAsesor.JUNIOR: Decimal("1.00"),
    NivelAsesor.SENIOR: Decimal("1.50"),
    NivelAsesor.EXPERTO: Decimal("2.20"),
}


class AsesoriaEspecializada(Servicio):
    """
    Servicio de asesoría por horas.

    Reglas:
    - Se cobra por horas o medias horas, entre 2 y 12.
    - El valor de la hora depende del nivel del asesor.
    - Cada asesoría tiene especialidad y asesor asignado.
    """
    UNIDAD_MEDIDA = "hora"
    UNIDAD_PLURAL = "horas"
    HORAS_POR_UNIDAD = Decimal("1")
    CANTIDAD_MINIMA = Decimal("2")
    CANTIDAD_MAXIMA = Decimal("12")

    def __init__(
        self,
        codigo: object,
        nombre: object,
        tarifa_hora: object,
        especialidad: object,
        nivel: NivelAsesor,
        asesor: object,
        disponible: bool = True,
    ) -> None:
        """Valida especialidad, nivel y asesor."""
        super().__init__(codigo, nombre, tarifa_hora, disponible)
        self._especialidad = limpiar_texto(
            especialidad, "especialidad", longitud_maxima=60
        )
        if not isinstance(nivel, NivelAsesor):
            raise DatosInvalidosError("El nivel del asesor no es válido.")
        self._nivel = nivel
        self._asesor = limpiar_texto(asesor, "asesor", longitud_maxima=60)

    # ------------------------------ PROPIEDADES -----------------------------
    @property
    def especialidad(self) -> str:
        """Especialidad de la asesoría."""
        return self._especialidad

    @property
    def nivel(self) -> NivelAsesor:
        """Nivel del asesor."""
        return self._nivel

    @property
    def asesor(self) -> str:
        """Nombre del asesor asignado."""
        return self._asesor

    # ------------------------------ VALIDACIÓN ------------------------------
    def validar_parametros(self, cantidad: object) -> Decimal:
        """Sobrescritura: solo se permiten horas o medias horas."""
        valor = super().validar_parametros(cantidad)
        if (valor * 2) != (valor * 2).to_integral_value():
            raise DatosInvalidosError(
                "La asesoría se cobra por horas o medias horas (2, 2.5, 3...)."
            )
        return valor

    # -------------------------------- COSTOS --------------------------------
    def _calcular_subtotal(self, cantidad: Decimal, **opciones: object) -> Decimal:
        """Aplica el factor del nivel del asesor."""
        # El nivel (junior, senior o experto) multiplica la tarifa por hora.
        factor = FACTOR_NIVEL_ASESOR[self._nivel]
        return self._tarifa_base * cantidad * factor

    # -------------------------------- FICHA ---------------------------------
    def describir(self) -> str:
        """Ficha completa de la asesoría."""
        return (
            super().describir()
            + f"\n   Especialidad: {self._especialidad} | "
              f"Nivel: {self._nivel.value}"
            + f"\n   Asesor asignado: {self._asesor}"
        )

    def _validar_reglas_propias(self) -> None:
        """Valida los datos propios de la asesoría."""
        super()._validar_reglas_propias()
        if not isinstance(self._nivel, NivelAsesor):
            raise DatosInvalidosError("El nivel del asesor no es válido.")
        if not self._especialidad or not self._asesor:
            raise DatosInvalidosError(
                "La asesoría debe tener especialidad y asesor asignado."
            )

# SECCIÓN 10. RESERVA
class EstadoReserva(Enum):
    """
    Estados posibles de una reserva.

    Transiciones permitidas:
    PENDIENTE -> CONFIRMADA -> PROCESADA
    PENDIENTE o CONFIRMADA -> CANCELADA
    PROCESADA y CANCELADA son estados finales.
    """
    PENDIENTE = "Pendiente"
    CONFIRMADA = "Confirmada"
    PROCESADA = "Procesada"
    CANCELADA = "Cancelada"

class Reserva(EntidadSistema):
    """
    Integra un cliente, un servicio, una duración y un estado.

    La reserva valida que el cliente y el servicio existan, que la fecha sea
    futura y que no haya cruces de horario. Los cambios de estado se hacen
    con confirmar(), cancelar() y procesar().
    """
    PREFIJO_ID = "RES"
    _contador = itertools.count(1)
    # La reserva debe hacerse con al menos 30 minutos de anticipación.
    ANTICIPACION_MINIMA = timedelta(minutes=30)
    # La cancelación exige al menos 2 horas de anticipación.
    HORAS_MINIMAS_CANCELACION = 2

    def __init__(self, cliente: Cliente, servicio: Servicio,
                 fecha_hora_inicio: datetime, cantidad: object,
                 impuesto: Optional[object] = None,
                 descuento: Optional[object] = None,
                 observaciones: object = "") -> None:
        """Valida cliente, servicio, fecha y duración."""
        super().__init__()
        # Se comprueba que los objetos recibidos sean del tipo correcto.
        if not isinstance(cliente, Cliente):
            raise DatosInvalidosError("La reserva debe recibir un cliente válido.")
        if not isinstance(servicio, Servicio):
            raise DatosInvalidosError("La reserva debe recibir un servicio válido.")
        if not isinstance(fecha_hora_inicio, datetime):
            raise DatosInvalidosError("La fecha y hora de inicio no es válida.")
        self._cliente = cliente
        self._servicio = servicio
        self._inicio = fecha_hora_inicio
        # La cantidad la valida el propio servicio (horas, días o medias horas).
        self._cantidad = servicio.validar_parametros(cantidad)
        # Impuesto y descuento son opcionales; si no llegan se usan los valores
        # por defecto (IVA 19% y descuento 0%).
        self._impuesto = (IMPUESTO_IVA if impuesto is None else
                          convertir_decimal(impuesto, "impuesto",
                                            Decimal("0"), TASA_MAXIMA))
        self._descuento = (Decimal("0") if descuento is None else
                           convertir_decimal(descuento, "descuento",
                                             Decimal("0"), TASA_MAXIMA))
        self._observaciones = limpiar_texto(
            observaciones, "observaciones", 150, obligatorio=False)
        # Estado inicial y datos de control de la reserva.
        self._estado = EstadoReserva.PENDIENTE
        self._total = Decimal("0.00")
        self._motivo_cancelacion = ""
        self._intentos_procesamiento = 0
        self._validar_creacion()

    @property
    def cliente(self) -> Cliente:
        """Cliente que realiza la reserva."""
        return self._cliente

    @property
    def servicio(self) -> Servicio:
        """Servicio reservado."""
        return self._servicio

    @property
    def inicio(self) -> datetime:
        """Fecha y hora de inicio."""
        return self._inicio

    @property
    def cantidad(self) -> Decimal:
        """Cantidad de unidades reservadas."""
        return self._cantidad

    @property
    def estado(self) -> EstadoReserva:
        """Estado actual de la reserva."""
        return self._estado

    @property
    def total(self) -> Decimal:
        """Total calculado de la reserva."""
        return self._total

    @property
    def impuesto(self) -> Decimal:
        """Tasa de impuesto aplicada."""
        return self._impuesto

    @property
    def descuento(self) -> Decimal:
        """Tasa de descuento aplicada."""
        return self._descuento

    @property
    def observaciones(self) -> str:
        """Observaciones de la reserva."""
        return self._observaciones

    @property
    def motivo_cancelacion(self) -> str:
        """Motivo registrado al cancelar."""
        return self._motivo_cancelacion

    @property
    def intentos_procesamiento(self) -> int:
        """Intentos de procesamiento realizados."""
        return self._intentos_procesamiento

    @property
    def fin(self) -> datetime:
        """Calcula la fecha y hora de finalización."""
        # Se convierten las unidades del servicio a horas y luego a minutos.
        horas = self._cantidad * self._servicio.HORAS_POR_UNIDAD
        return self._inicio + timedelta(minutes=int(horas * 60))

    def duracion_legible(self) -> str:
        """Devuelve la duración en texto."""
        # Se quitan los ceros decimales sobrantes: 2.50 -> 2.5.
        cantidad = f"{self._cantidad:.2f}".rstrip("0").rstrip(".")
        unidad = (self._servicio.unidad_medida if self._cantidad == 1
                  else self._servicio.unidad_plural)
        return f"{cantidad} {unidad}"

    def _calcular_total(self) -> Decimal:
        """Pide el costo al servicio y valida el total."""
        # Cada servicio calcula su costo con su propia regla (polimorfismo).
        total = self._servicio.calcular_costo(
            self._cantidad, self._impuesto, self._descuento)
        if total <= 0:
            raise CalculoInconsistenteError(
                f"El total de la reserva {self.id} es inválido: {total}.")
        return total

    def _validar_creacion(self) -> None:
        """Valida las reglas para crear la reserva."""
        try:
            # Se validan cliente y servicio y se comprueba disponibilidad.
            self._cliente.validar()
            self._servicio.validar()
            self._servicio.verificar_disponibilidad()
        except ErrorSistemaFJ as error:
            # Encadenamiento: se conserva la causa original del rechazo.
            raise ReservaInvalidaError(
                f"No se pudo crear la reserva para el servicio "
                f"{self._servicio.codigo}.") from error
        # La fecha debe tener la anticipación mínima exigida.
        if self._inicio < datetime.now() + self.ANTICIPACION_MINIMA:
            raise ReservaInvalidaError(
                "La reserva debe iniciar al menos 30 minutos después de ahora.")
        # Un cliente inactivo no puede reservar.
        if not self._cliente.activo:
            raise ReservaInvalidaError(
                f"El cliente {self._cliente.nombre_completo()} está inactivo.")
        self._total = self._calcular_total()

    def se_solapa_con(self, otra: "Reserva") -> bool:
        """Indica si dos reservas se cruzan en el tiempo."""
        if not isinstance(otra, Reserva):
            raise DatosInvalidosError("Solo se comparan reservas entre sí.")
        # Dos intervalos se solapan si uno empieza antes de que termine el otro.
        return self._inicio < otra.fin and otra.inicio < self.fin

    def confirmar(self) -> Decimal:
        """Pasa la reserva de pendiente a confirmada."""
        # Solo una reserva pendiente puede confirmarse.
        if self._estado is not EstadoReserva.PENDIENTE:
            raise OperacionNoPermitidaError(
                f"Solo se confirman reservas pendientes. "
                f"Estado actual: {self._estado.value}.")
        try:
            # Se revalida la disponibilidad por si cambió desde la creación.
            self._servicio.verificar_disponibilidad()
            if not self._cliente.activo:
                raise ReservaInvalidaError("El cliente está inactivo.")
            total = self._calcular_total()
        except ServicioNoDisponibleError as error:
            # Se conserva la causa real mediante encadenamiento.
            raise ReservaInvalidaError(
                f"La reserva {self.id} no puede confirmarse.") from error
        else:
            # El bloque else solo se ejecuta si no hubo excepción.
            self._total = total
            self._estado = EstadoReserva.CONFIRMADA
            return self._total

    def cancelar(self, motivo: str) -> str:
        """Cancela la reserva y guarda el motivo."""
        # No se puede cancelar una reserva ya cancelada o procesada.
        if self._estado is EstadoReserva.CANCELADA:
            raise ReservaInvalidaError(f"La reserva {self.id} ya está cancelada.")
        if self._estado is EstadoReserva.PROCESADA:
            raise OperacionNoPermitidaError(
                "Una reserva procesada no se puede cancelar.")
        motivo_limpio = limpiar_texto(motivo, "motivo de cancelación", 150)
        # Se exige el tiempo mínimo de anticipación.
        if self._inicio - datetime.now() < timedelta(
                hours=self.HORAS_MINIMAS_CANCELACION):
            raise OperacionNoPermitidaError(
                "Solo se cancela con al menos "
                f"{self.HORAS_MINIMAS_CANCELACION} horas de anticipación.")
        self._estado = EstadoReserva.CANCELADA
        self._motivo_cancelacion = motivo_limpio
        return motivo_limpio

    def procesar(self) -> Decimal:
        """Pasa la reserva de confirmada a procesada."""
        # Solo una reserva confirmada puede procesarse.
        if self._estado is not EstadoReserva.CONFIRMADA:
            raise OperacionNoPermitidaError(
                f"Solo se procesan reservas confirmadas. "
                f"Estado actual: {self._estado.value}.")
        try:
            total = self._calcular_total()
        except CalculoInconsistenteError as error:
            raise ReservaInvalidaError(
                f"No se pudo procesar la reserva {self.id}.") from error
        else:
            self._total = total
            self._estado = EstadoReserva.PROCESADA
            return self._total
        finally:
            # El intento se cuenta aunque el procesamiento falle.
            self._intentos_procesamiento += 1

    def describir(self) -> str:
        """Ficha completa de la reserva."""
        lineas = [
            f"Reserva {self.id} | Estado: {self._estado.value}",
            f"   Cliente: {self._cliente.nombre_completo()} "
            f"({self._cliente.documento_mascarado()})",
            f"   Servicio: {self._servicio.codigo} - {self._servicio.nombre}",
            f"   Inicio: {formatear_fecha(self._inicio)} | "
            f"Fin: {formatear_fecha(self.fin)}",
            f"   Duración: {self.duracion_legible()} | "
            f"Total: {formatear_moneda(self._total)}",
            f"   IVA: {formatear_porcentaje(self._impuesto)} | "
            f"Descuento: {formatear_porcentaje(self._descuento)}",
        ]
        if self._observaciones:
            lineas.append(f"   Observaciones: {self._observaciones}")
        if self._motivo_cancelacion:
            lineas.append(f"   Motivo de cancelación: {self._motivo_cancelacion}")
        return "\n".join(lineas)

    def _validar_reglas_propias(self) -> None:
        """Valida las reglas internas de la reserva."""
        if not isinstance(self._cliente, Cliente):
            raise DatosInvalidosError("La reserva no tiene un cliente válido.")
        if not isinstance(self._servicio, Servicio):
            raise DatosInvalidosError("La reserva no tiene un servicio válido.")
        if not isinstance(self._estado, EstadoReserva):
            raise DatosInvalidosError("La reserva tiene un estado desconocido.")
        if self._cantidad <= 0:
            raise DatosInvalidosError("La duración debe ser positiva.")

    def __str__(self) -> str:
        """Resumen corto de la reserva."""
        return (f"{self.id} - {self._estado.value} - "
                f"{self._cliente.nombre_completo()} - {self._servicio.codigo} - "
                f"{formatear_fecha(self._inicio)}")

# SECCIÓN 11. SISTEMA DE GESTIÓN (FACHADA)
class SistemaGestionFJ:
    """
    Fachada que coordina clientes, servicios y reservas.

    Mantiene las listas internas, controla duplicados y conflictos de agenda,
    registra los eventos y ofrece los métodos que usan la GUI y la consola.
    No hay base de datos: toda la información vive en estas listas.
    """

    def __init__(self, registro: Optional[RegistroEventos] = None) -> None:
        """Crea las listas internas y el registro de eventos."""
        # Si no se recibe un registro, se crea uno propio.
        self._registro = registro if registro is not None else RegistroEventos()
        # Listas internas: aquí vive toda la información del sistema.
        self._clientes: List[Cliente] = []
        self._servicios: List[Servicio] = []
        self._reservas: List[Reserva] = []
        self._registro.info(
            f"Sistema {NOMBRE_EMPRESA} v{VERSION_PROGRAMA} iniciado correctamente."
        )

    # ------------------------------ PROPIEDADES -----------------------------
    @property
    def registro(self) -> RegistroEventos:
        """Registro de eventos del sistema."""
        return self._registro

    @property
    def clientes(self) -> List[Cliente]:
        """Copia de la lista para que nadie modifique la original por fuera."""
        return list(self._clientes)

    @property
    def servicios(self) -> List[Servicio]:
        """Copia de la lista de servicios."""
        return list(self._servicios)

    @property
    def reservas(self) -> List[Reserva]:
        """Copia de la lista de reservas."""
        return list(self._reservas)

    # --------------------------- CLIENTES -----------------------------------
    def registrar_cliente(
        self,
        documento: object,
        nombre: object,
        apellido: object,
        correo: object,
        telefono: object,
        direccion: object = "",
        tipo: TipoCliente = TipoCliente.NATURAL,
    ) -> Cliente:
        """Crea y registra un cliente."""
        try:
            # Se normaliza el documento y se busca un duplicado exacto.
            documento = validar_documento(documento)
            if any(c.documento == documento for c in self._clientes):
                raise EntidadDuplicadaError(
                    f"Ya existe un cliente con el documento "
                    f"{enmascarar(documento)}.")
            # El constructor valida todos los datos antes de guardar.
            cliente = Cliente(documento, nombre, apellido, correo, telefono,
                              direccion, tipo)
            cliente.validar()
        except ErrorSistemaFJ as error:
            # Todo registro rechazado queda en el log.
            self._registro.error("Registro de cliente rechazado.", error)
            raise
        self._clientes.append(cliente)
        self._registro.info(f"Cliente {cliente.id} registrado.")
        return cliente

    def buscar_cliente(self, documento: object) -> Cliente:
        """Busca un cliente por documento o lanza ClienteNoEncontradoError."""
        documento_normalizado = validar_documento(documento)
        for cliente in self._clientes:
            if cliente.documento == documento_normalizado:
                return cliente
        raise ClienteNoEncontradoError(
            f"No existe un cliente con el documento {enmascarar(documento_normalizado)}."
        )

    # --------------------------- SERVICIOS ----------------------------------
    def registrar_servicio(self, servicio: Servicio) -> Servicio:
        """Registra un servicio y rechaza códigos duplicados."""
        try:
            # Solo se aceptan objetos de la jerarquía Servicio.
            if not isinstance(servicio, Servicio):
                raise DatosInvalidosError(
                    "Solo se pueden registrar objetos de tipo Servicio.")
            # La comparación de códigos no distingue mayúsculas.
            if any(s.codigo.upper() == servicio.codigo.upper()
                   for s in self._servicios):
                raise EntidadDuplicadaError(
                    f"Ya existe un servicio con el código {servicio.codigo}.")
            servicio.validar()
        except ErrorSistemaFJ as error:
            codigo = getattr(servicio, "codigo", "?")
            self._registro.error(f"Servicio rechazado: {codigo}.", error)
            raise
        self._servicios.append(servicio)
        self._registro.info(
            f"Servicio {servicio.codigo} registrado: {servicio.nombre}.")
        return servicio

    def buscar_servicio(self, codigo: object) -> Servicio:
        """Busca un servicio por código o lanza ServicioNoEncontradoError."""
        texto = limpiar_texto(codigo, "código de servicio", longitud_maxima=20).upper()
        for servicio in self._servicios:
            if servicio.codigo.upper() == texto:
                return servicio
        raise ServicioNoEncontradoError(
            f"No existe un servicio con el código {texto}."
        )

    def cambiar_disponibilidad(
        self, codigo_servicio: object, disponible: bool, motivo: str = ""
    ) -> Servicio:
        """Bloquea o habilita un servicio y deja constancia en el log."""
        servicio = self.buscar_servicio(codigo_servicio)
        if disponible:
            servicio.marcar_disponible()
            self._registro.info(f"Servicio {servicio.codigo} habilitado nuevamente.")
        else:
            servicio.marcar_no_disponible(motivo)
            self._registro.advertencia(
                f"Servicio {servicio.codigo} marcado como NO disponible. "
                f"Motivo: {motivo or '(sin motivo)'}."
            )
        return servicio

    # ---------------------------- RESERVAS ----------------------------------
    def crear_reserva(
        self,
        documento_cliente: object,
        codigo_servicio: object,
        fecha_hora_inicio: datetime,
        cantidad: object,
        impuesto: Optional[object] = None,
        descuento: Optional[object] = None,
        observaciones: object = "",
    ) -> Reserva:
        """Crea una reserva validando cliente, servicio y agenda."""
        try:
            # Primero se buscan las entidades relacionadas.
            cliente = self.buscar_cliente(documento_cliente)
            servicio = self.buscar_servicio(codigo_servicio)
            # El constructor de Reserva valida fecha, cantidad y disponibilidad.
            reserva = Reserva(cliente, servicio, fecha_hora_inicio, cantidad,
                              impuesto, descuento, observaciones)
        except (ClienteNoEncontradoError, ServicioNoEncontradoError) as error:
            # Los errores de búsqueda se convierten en un error de reserva.
            self._registro.error("Reserva sin cliente o servicio.", error)
            raise ReservaInvalidaError(
                "El cliente o el servicio no existen.") from error
        except ErrorSistemaFJ as error:
            self._registro.advertencia(f"Reserva rechazada: {error}")
            raise
        # Se revisa que no choque con otra reserva antes de guardarla.
        self._verificar_conflictos(reserva)
        self._reservas.append(reserva)
        self._registro.info(f"Reserva {reserva.id} creada.")
        return reserva

    def _verificar_conflictos(self, nueva: Reserva) -> None:
        """Impide cruces de horario del mismo servicio o cliente."""
        for reserva in self._reservas:
            # Las reservas canceladas liberan el horario.
            if (reserva.estado is EstadoReserva.CANCELADA
                    or not reserva.se_solapa_con(nueva)):
                continue
            # Un mismo servicio no puede tener dos reservas cruzadas.
            if reserva.servicio.codigo == nueva.servicio.codigo:
                raise ConflictoAgendaError(
                    f"El servicio {nueva.servicio.codigo} ya está reservado "
                    f"de {formatear_fecha(reserva.inicio)} a "
                    f"{formatear_fecha(reserva.fin)}.")
            # Un cliente tampoco puede estar en dos servicios a la misma hora.
            if reserva.cliente.documento == nueva.cliente.documento:
                raise ConflictoAgendaError(
                    f"El cliente ya tiene la reserva {reserva.id} "
                    "en ese mismo horario.")

    def buscar_reserva(self, id_reserva: object) -> Reserva:
        """Busca una reserva por su identificador (RES-0001)."""
        texto = limpiar_texto(id_reserva, "id de reserva", longitud_maxima=20).upper()
        for reserva in self._reservas:
            if reserva.id.upper() == texto:
                return reserva
        raise EntidadNoEncontradaError(
            f"No existe una reserva con el identificador {texto}."
        )

    def confirmar_reserva(self, id_reserva: object) -> Decimal:
        """Confirma una reserva pendiente y devuelve el total."""
        # Se busca la reserva y se delega el cambio de estado a la entidad.
        reserva = self.buscar_reserva(id_reserva)
        try:
            total = reserva.confirmar()
        except ErrorSistemaFJ as error:
            # El error se registra y se vuelve a lanzar para la interfaz.
            self._registro.error(
                f"No se pudo confirmar la reserva {reserva.id}.", error
            )
            raise
        else:
            # Solo se registra el éxito si no hubo excepción.
            self._registro.info(
                f"Reserva {reserva.id} confirmada. "
                f"Total con IVA: {formatear_moneda(total)}."
            )
            return total

    def cancelar_reserva(self, id_reserva: object, motivo: str) -> str:
        """Cancela una reserva y devuelve el motivo registrado."""
        reserva = self.buscar_reserva(id_reserva)
        try:
            motivo_registrado = reserva.cancelar(motivo)
        except ErrorSistemaFJ as error:
            self._registro.error(
                f"No se pudo cancelar la reserva {reserva.id}.", error
            )
            raise
        else:
            self._registro.info(
                f"Reserva {reserva.id} cancelada. Motivo: {motivo_registrado}."
            )
            return motivo_registrado

    def procesar_reserva(self, id_reserva: object) -> Decimal:
        """Marca como procesada una reserva confirmada y devuelve el total."""
        reserva = self.buscar_reserva(id_reserva)
        try:
            total = reserva.procesar()
        except ErrorSistemaFJ as error:
            self._registro.error(
                f"No se pudo procesar la reserva {reserva.id}.", error
            )
            raise
        else:
            self._registro.info(
                f"Reserva {reserva.id} procesada. "
                f"Valor facturado: {formatear_moneda(total)}."
            )
            return total

    # ----------------------------- CONSULTAS --------------------------------
    def servicios_disponibles(self) -> List[Servicio]:
        """Servicios que pueden recibir reservas en este momento."""
        return [servicio for servicio in self._servicios if servicio.disponible]

    def reservas_por_estado(self, estado: EstadoReserva) -> List[Reserva]:
        """Filtra las reservas por estado."""
        return [reserva for reserva in self._reservas if reserva.estado is estado]

    def contar_clientes_naturales(self) -> int:
        """Cuenta los clientes registrados como persona natural."""
        # Se recorre la lista y se cuentan solo los clientes naturales.
        total = sum(
            1 for cliente in self._clientes
            if cliente.tipo is TipoCliente.NATURAL
        )
        self._registro.info(f"Clientes naturales registrados: {total}.")
        return total

    def resumen(self) -> str:
        """Texto con los contadores generales del sistema."""
        pendientes = len(self.reservas_por_estado(EstadoReserva.PENDIENTE))
        confirmadas = len(self.reservas_por_estado(EstadoReserva.CONFIRMADA))
