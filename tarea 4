    def _demo_paso(
        self,
        numero: int,
        descripcion: str,
        accion: Callable[[], str],
    ) -> str:
        """
        Ejecuta un paso de la demostración y clasifica el resultado.

        Aquí se usan las cuatro formas de manejo de excepciones:
          try / except / except múltiple / else / finally
        Devuelve: "OK", "CONTROLADO" (error de negocio esperado) o
                  "INESPERADO" (error de programación: hay que revisar).
        """
        print(f"\n[{numero:02d}] {descripcion}")
        try:
            detalle = accion()
        except ErrorSistemaFJ as error:
            # Error de negocio: es parte normal de la demostración.
            self._registro.advertencia(
                f"DEMO {numero:02d} | fallo controlado | "
                f"{type(error).__name__}: {error}"
            )
            print("     RESULTADO: fallo controlado")
            print(f"     Excepción: {type(error).__name__}: {error}")
            if error.__cause__ is not None:
                print(
                    f"     Encadenada: {type(error.__cause__).__name__}: "
                    f"{error.__cause__}"
                )
            return "CONTROLADO"
        except (ValueError, TypeError) as error:
            # Error de tipo: indica un fallo interno que debe corregirse.
            self._registro.error(f"DEMO {numero:02d} | error inesperado", error)
            print(f"     RESULTADO: error inesperado -> {error}")
            return "INESPERADO"
        except Exception as error:  # red de seguridad final
            self._registro.critico(f"DEMO {numero:02d} | error no controlado", error)
            print(f"     RESULTADO: error no controlado -> {error}")
            return "INESPERADO"
        else:
            # Solo se ejecuta cuando NO hubo ninguna excepción.
            self._registro.info(f"DEMO {numero:02d} | exitoso | {detalle}")
            print("     RESULTADO: OK")
            print(f"     Detalle: {detalle}")
            return "OK"
        finally:
            # Se ejecute bien o mal, siempre se imprime el cierre del paso.
            print(f"     {SUBSECCION[:60]}")

