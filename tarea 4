    # ------------------------- Utilidades de widgets ------------------------
    def _crear_campo(
        self,
        padre,
        fila: int,
        texto: str,
        variable,
        ancho: int = 28,
    ):
        """Crea una etiqueta y un Entry enlazado a una variable de Tkinter."""
        ttk.Label(padre, text=texto).grid(row=fila, column=0, sticky="w", pady=4)
        entrada = ttk.Entry(padre, textvariable=variable, width=ancho)
        entrada.grid(row=fila, column=1, sticky="ew", pady=4)
        return entrada

    def _crear_combo(
        self,
        padre,
        fila: int,
        texto: str,
        variable,
        valores,
        ancho: int = 26,
    ):
        """Crea una etiqueta y un Combobox de solo lectura."""
        ttk.Label(padre, text=texto).grid(row=fila, column=0, sticky="w", pady=4)
        combo = ttk.Combobox(
            padre,
            textvariable=variable,
            values=valores,
            state="readonly",
            width=ancho,
        )
        combo.grid(row=fila, column=1, sticky="ew", pady=4)
        return combo

    def _crear_tabla(
        self,
        padre,
        columnas: List[tuple],
        anchos: List[int],
        alto: int = 14,
    ):
        """
        Crea una tabla Treeview con su barra de desplazamiento vertical.

        columnas: lista de tuplas (clave, título visible).
        anchos  : ancho inicial de cada columna, en píxeles.
        """
        tabla = ttk.Treeview(
            padre,
            columns=[clave for clave, _ in columnas],
            show="headings",
            height=alto,
        )
        for (clave, titulo), ancho in zip(columnas, anchos):
            tabla.heading(clave, text=titulo, anchor="w")
            tabla.column(clave, width=ancho, minwidth=50, anchor="w", stretch=True)

        barra = ttk.Scrollbar(padre, orient="vertical", command=tabla.yview)
        tabla.configure(yscrollcommand=barra.set)
        tabla.grid(row=0, column=0, sticky="nsew")
        barra.grid(row=0, column=1, sticky="ns")
        return tabla

    @staticmethod
    def _recortar(texto: object, maximo: int = 32) -> str:
        """
        Recorta un texto largo con puntos suspensivos para que no desborde
        las columnas de la tabla. Ejemplo: 'TecnoSoluciones S.A.S. ...'
        """
        cadena = str(texto)
        if len(cadena) <= maximo:
            return cadena
        return cadena[: maximo - 1].rstrip() + "…"

