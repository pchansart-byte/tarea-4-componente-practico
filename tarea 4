    print("\n  La demostración usa una instancia nueva del sistema.")
    SistemaGestionFJ(sistema.registro).ejecutar_demostracion()

def accion_ver_log(sistema: SistemaGestionFJ) -> None:
    """Muestra la ruta y las últimas líneas del log."""
    print(f"\n{SUBSECCION}\n ARCHIVO DE LOGS\n{SUBSECCION}")
    registro = sistema.registro
    try:
        if not registro.archivo_operativo:
            raise OSError("archivo no disponible")
        with open(registro.ruta_archivo, "r", encoding="utf-8",
                  errors="replace") as archivo:
            lineas = archivo.readlines()
    except OSError as error:
        print(f"  [X] No se pudo leer el log: {error}")
    else:
        print(f"  Ruta: {registro.ruta_archivo}")
        print(f"  Líneas: {len(lineas)}\n")
        for linea in lineas[-20:]:
            print("  " + linea.rstrip())
    finally:
        print(f"\n  Eventos en memoria: {registro.eventos_en_memoria}")

def bucle_principal(sistema: SistemaGestionFJ) -> None:
    """Muestra el menú y ejecuta la opción elegida."""
    # Diccionario que asocia cada opción con su función.
    acciones = {
        "1": accion_registrar_cliente, "2": accion_registrar_servicio,
        "3": accion_crear_reserva, "4": accion_listar_clientes,
        "5": accion_listar_servicios, "6": accion_listar_reservas,
        "7": accion_buscar_cliente, "8": accion_confirmar_reserva,
        "9": accion_cancelar_reserva, "10": accion_procesar_reserva,
        "11": accion_demostracion, "12": accion_ver_log,
        "13": accion_reporte_naturales,
    }
    while True:
        mostrar_menu(sistema)
        opcion = pedir_texto("Seleccione una opción: ")
        if opcion == "0":
            print("\n  Cerrando el sistema.\n")
            return
        accion = acciones.get(opcion)
        if accion is None:
            print("\n  [!] Opción no válida.")
            pausar()
            continue
        try:
            accion(sistema)
        except SalidaSolicitada:
            # El cierre ordenado lo maneja main().
            raise
        except KeyboardInterrupt:
            raise
        except ErrorSistemaFJ as error:
            # Un error de negocio no debe tumbar el menú.
            sistema.registro.error("Operación del menú rechazada.", error)
            print(f"\n  [X] {error}")
        except Exception as error:
            # Cualquier otro error se registra como crítico.
            sistema.registro.critico("Error no controlado en el menú.", error)
            print("\n  [X] Error inesperado. Revise el log.")
        # La pausa queda fuera del try para que Ctrl+C salga de inmediato.
        pausar()

def main(argv: Optional[List[str]] = None) -> int:
    """Punto de entrada: GUI por defecto, consola con --consola, demo con --demo."""
    configurar_consola()
    argumentos = list(sys.argv[1:] if argv is None else argv)
    if "--version" in argumentos or "-v" in argumentos:
        print(f"{NOMBRE_EMPRESA} v{VERSION_PROGRAMA}")
        return 0
    mostrar_banner()
    # El logger nunca lanza excepciones y limpia el archivo al iniciar.
    registro = RegistroEventos()
    sistema = SistemaGestionFJ(registro)
    print(f"  Archivo de logs: {registro.ruta_archivo}")
    print(SEPARADOR)
    # Modos disponibles desde la línea de comandos.
    modo_demo = any(a.lower() in ("--demo", "-d", "demo") for a in argumentos)
    modo_consola = any(
        a.lower() in ("--consola", "-c", "consola") for a in argumentos)
    try:
        if modo_demo:
            # Demostración sin interacción.
            sistema.ejecutar_demostracion()
        elif modo_consola:
            # Menú de texto solicitado explícitamente.
            bucle_principal(sistema)
        elif not iniciar_interfaz_grafica(sistema):
            # Si no hay Tkinter o pantalla, se usa la consola.
            print("  Iniciando la consola...")
            bucle_principal(sistema)
    except SalidaSolicitada:
        print("\n  Entrada finalizada. Cerrando...")
        registro.advertencia("Ejecución finalizada por fin de la entrada.")
    except KeyboardInterrupt:
        print("\n  Interrupción detectada. Cerrando...")
        registro.advertencia("Ejecución interrumpida por el usuario.")
    except Exception as error:
        # Error no previsto: se registra y se informa sin mostrar la traza.
        registro.critico("Error no controlado durante la ejecución.", error)
        print("\n  [X] Error inesperado. Revise el archivo de logs.")
        return 1
    finally:
        # Pase lo que pase, se registra el cierre ordenado.
        try:
            sistema.cerrar()
        except Exception:
            pass
    print("\n  Gracias por usar Software FJ.\n")
    return 0

if __name__ == "__main__":
    sys.exit(main())
