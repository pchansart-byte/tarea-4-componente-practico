# El objetivo es que cualquier persona pueda usar el programa sin manual:
# menú numerado, preguntas claras y mensajes de error en español.

def configurar_consola() -> None:
    """
    Fuerza la salida en UTF-8 para que las tildes y la ñ se vean bien en
    cualquier computador (Windows incluido). Si no se puede, no pasa nada.
    """
    for flujo in (sys.stdout, sys.stderr):
        try:
            flujo.reconfigure(encoding="utf-8", errors="replace")  # type: ignore[attr-defined]
        except (AttributeError, ValueError, OSError):
            # En consolas muy antiguas simplemente se deja la configuración.
            continue


def pedir_texto(
    mensaje: str,
    obligatorio: bool = True,
    longitud_maxima: int = 80,
    valor_defecto: Optional[str] = None,
) -> str:
    """
    Pide un texto por teclado.
    - Si el usuario presiona Ctrl+C o se acaba la entrada, se lanza
      SalidaSolicitada para cerrar el programa ordenadamente.
    - Si se envía valor_defecto, basta con presionar ENTER para usarlo.
    """
    while True:
        try:
            entrada = input(mensaje).strip()
        except EOFError as error:
            # Ocurre al redirigir la entrada o con Ctrl+Z / Ctrl+D.
            raise SalidaSolicitada("Fin de la entrada estándar.") from error

        if not entrada:
            if valor_defecto is not None:
                return valor_defecto
            if not obligatorio:
                return ""
            print("  [!] Este dato es obligatorio. Intente de nuevo.")
            continue

        if len(entrada) > longitud_maxima:
            print(f"  [!] Máximo {longitud_maxima} caracteres.")
            continue

        return entrada


def pedir_opcion(mensaje: str, opciones_validas: tuple) -> str:
    """Repite la pregunta hasta que el usuario escriba una opción válida."""
    while True:
        valor = pedir_texto(mensaje)
        if valor in opciones_validas:
            return valor
        permitidas = ", ".join(opciones_validas)
        print(f"  [!] Opción no válida. Escriba uno de estos valores: {permitidas}.")


def pedir_entero(
    mensaje: str,
    minimo: int,
    maximo: int,
    valor_defecto: Optional[int] = None,
) -> int:
    """Pide un número entero dentro de un rango, sin permitir que falle."""
    while True:
        texto = pedir_texto(mensaje, obligatorio=False)
        if not texto:
            if valor_defecto is not None:
                return valor_defecto
            print("  [!] Debe ingresar un número entero.")
            continue
        try:
            return convertir_entero(texto, "valor", minimo, maximo)
        except ErrorSistemaFJ as error:
            print(f"  [!] {error}")


def pedir_decimal(
    mensaje: str,
    minimo: Optional[Decimal] = None,
    maximo: Optional[Decimal] = None,
    valor_defecto: Optional[Decimal] = None,
) -> Decimal:
    """Pide un número decimal (acepta coma o punto) dentro de un rango."""
    while True:
        texto = pedir_texto(mensaje, obligatorio=False)
        if not texto:
            if valor_defecto is not None:
                return valor_defecto
            print("  [!] Debe ingresar un valor numérico.")
            continue
        try:
            return convertir_decimal(texto, "valor", minimo, maximo)
        except ErrorSistemaFJ as error:
            print(f"  [!] {error}")


def pedir_si_no(mensaje: str, defecto: bool = True) -> bool:
    """Pregunta de sí/no. Si se presiona ENTER, devuelve el valor por defecto."""
    while True:
        texto = pedir_texto(mensaje, obligatorio=False).lower()
        if texto == "":
            return defecto
        if texto in ("s", "si", "sí"):
            return True
        if texto in ("n", "no"):
            return False
        print("  [!] Responda 's' para sí o 'n' para no.")


def pedir_fecha_hora(mensaje: str) -> datetime:
    """Pide una fecha y hora con formato DD/MM/AAAA HH:MM."""
    while True:
        texto = pedir_texto(f"{mensaje} (DD/MM/AAAA HH:MM): ")
        try:
            return datetime.strptime(texto, "%d/%m/%Y %H:%M")
        except ValueError:
            print("  [!] Fecha u hora inválida. Ejemplo correcto: 25/11/2026 14:30")


def pausar() -> None:
    """Espera ENTER para que el usuario pueda leer el resultado."""
    try:
        input("\nPresione ENTER para continuar...")
    except EOFError as error:
        raise SalidaSolicitada("Fin de la entrada estándar.") from error


