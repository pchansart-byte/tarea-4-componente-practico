        print(f"  Total de líneas: {len(lineas)}")
        print(f"  Últimas {min(20, len(lineas))} líneas:\n")
        for linea in lineas[-20:]:
            print("  " + linea.rstrip())
    finally:
        # El finally se ejecuta siempre, incluso si hubo error.
        print(f"\n  Eventos pendientes en memoria: {registro.eventos_en_memoria}")


