    def _mostrar_calendario(self, evento) -> None:
        """Abre el calendario emergente para elegir la fecha."""
        # Si ya había un calendario abierto, se cierra para no duplicarlo.
        if getattr(self, "_popup_cal", None) and self._popup_cal.winfo_exists():
            self._popup_cal.destroy()
        # Se parte de la fecha escrita o, si no es válida, de mañana.
        try:
            base = datetime.strptime(self._res_fecha.get().strip(), "%d/%m/%Y")
        except ValueError:
            base = datetime.now() + timedelta(days=1)
        anio, mes = base.year, base.month
        # Toplevel sin bordes, ubicado debajo del campo de fecha.
        popup = tk.Toplevel(self._ventana)
        self._popup_cal = popup
        popup.wm_overrideredirect(True)
        popup.configure(bg=self.COLOR_ENCABEZADO, padx=1, pady=1)
        x = evento.widget.winfo_rootx()
        y = evento.widget.winfo_rooty() + evento.widget.winfo_height() + 2
        popup.geometry(f"+{x}+{y}")
        cont = tk.Frame(popup, bg="white", padx=8, pady=8)
        cont.pack(fill="both", expand=True)
        barra = tk.Frame(cont, bg="white")
        barra.pack(fill="x", pady=(0, 6))
        etiqueta = tk.Label(barra, bg="white", fg=self.COLOR_ENCABEZADO,
                            font=("Segoe UI", 9, "bold"))
        etiqueta.pack(side="left", expand=True)
        rejilla = tk.Frame(cont, bg="white")
        rejilla.pack()
        meses = ["", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
                 "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre",
                 "Diciembre"]

        def elegir(dia: int) -> None:
            """Escribe la fecha elegida y cierra el calendario."""
            self._res_fecha.set(f"{dia:02d}/{mes:02d}/{anio}")
            popup.destroy()

        def pintar() -> None:
            """Dibuja el mes actual con sus días y espacios vacíos."""
            # Se borra la cuadrícula anterior antes de dibujar el nuevo mes.
            for w in rejilla.winfo_children():
                w.destroy()
            etiqueta.config(text=f"{meses[mes]} {anio}")
            # Encabezados de los días de la semana.
            for col, nombre in enumerate(["Lu", "Ma", "Mi", "Ju", "Vi", "Sá", "Do"]):
                tk.Label(rejilla, text=nombre, bg="white", fg="#555555",
                         font=("Segoe UI", 8, "bold"), width=3).grid(
                    row=0, column=col, pady=(0, 3))
            # calendar.monthcalendar devuelve 0 en los días que no pertenecen
            # al mes; esos espacios se rellenan con etiquetas vacías.
            for fila, semana in enumerate(calendar.monthcalendar(anio, mes), 1):
                for col, dia in enumerate(semana):
                    if dia:
                        tk.Button(
                            rejilla, text=str(dia), width=3, relief="flat",
                            bg="#f0f4f8", fg=self.COLOR_TEXTO,
                            activebackground=self.COLOR_ENCABEZADO,
                            activeforeground="white", font=("Segoe UI", 8),
                            command=lambda d=dia: elegir(d),
                        ).grid(row=fila, column=col, padx=1, pady=1)
                    else:
                        tk.Label(rejilla, text="", bg="white", width=3).grid(
                            row=fila, column=col)

        def mover(meses: int = 0, anios: int = 0) -> None:
            """Cambia de mes o de año y vuelve a dibujar el calendario."""
            nonlocal anio, mes
            mes += meses
            anio += anios
            # Ajuste de límites: de diciembre se pasa a enero del año siguiente
            # y de enero al diciembre del año anterior.
            if mes > 12:
                mes, anio = 1, anio + 1
            elif mes < 1:
                mes, anio = 12, anio - 1
            pintar()

        # Botones de navegación: año anterior, mes anterior, mes siguiente,
        # año siguiente. Se ubican a los lados de la etiqueta central.
        for texto, comando in (
            ("«", lambda: mover(0, -1)), ("‹", lambda: mover(-1)),
            ("›", lambda: mover(1)), ("»", lambda: mover(0, 1)),
        ):
            lado = "left" if texto in ("«", "‹") else "right"
            tk.Button(barra, text=texto, relief="flat", bg="white",
                      command=comando).pack(side=lado)
        pintar()
        # Escape y pérdida de foco cierran el calendario.
        popup.bind("<Escape>", lambda e: popup.destroy())
        popup.bind(
            "<FocusOut>",
            lambda e: popup.destroy() if popup.focus_get() is None else None,
        )
        popup.focus_set()

    # --------------------------- BARRA DE ESTADO ----------------------------
    def _crear_barra_estado(self) -> None:
        """Crea la barra inferior con estado, log y botón."""
        barra = tk.Frame(self._ventana, bg=self.COLOR_BARRA)
        barra.grid(row=2, column=0, sticky="ew")
        barra.columnconfigure(0, weight=1)
        # La etiqueta muestra el resultado de la última operación.
        self._etiqueta_estado = tk.Label(
            barra, text="Sistema listo. Use las pestañas para gestionar la información.",
            bg=self.COLOR_BARRA, fg=self.COLOR_TEXTO, anchor="w",
            padx=10, pady=6, font=self.FUENTE,
        )
        self._etiqueta_estado.grid(row=0, column=0, sticky="ew")
        # Botón para abrir el visor del archivo de logs.
        ttk.Button(barra, text="Ver log", command=self._ver_log).grid(
            row=0, column=1, padx=6, pady=4)
        tk.Label(
            barra, text=f"Log: {Path(self._sistema.registro.ruta_archivo).name}",
            bg=self.COLOR_BARRA, fg="#4a5560", padx=10, font=("Segoe UI", 8),
        ).grid(row=0, column=2, sticky="e")

    def _inicializar_valores(self) -> None:
        """Asigna los valores iniciales de los formularios."""
        # Valores cómodos para que el usuario no empiece con campos vacíos.
        self._cli_tipo.set(TipoCliente.NATURAL.value)
        self._srv_tipo.set(self.TIPO_SALA)
        self._srv_tipo_sala.set(TipoSala.SALA_JUNTAS.value)
        self._srv_nivel.set(NivelAsesor.JUNIOR.value)
        self._res_fecha.set((datetime.now() + timedelta(days=1)).strftime("%d/%m/%Y"))
        self._res_hora.set("09:00")
        self._res_iva.set("19")
        self._res_descuento.set("0")
        # Muestra los campos correspondientes al tipo de servicio inicial.
        self._cambiar_tipo_servicio()

    # ---------------------------- ACTUALIZACIÓN -----------------------------
    def _actualizar_todo(self) -> None:
        """Refresca las tablas y los contadores."""
        # Se llama al abrir la ventana y después de cada operación.
        self._actualizar_clientes()
        self._actualizar_servicios()
        self._actualizar_reservas()
        self._actualizar_resumen()

    def _actualizar_resumen(self) -> None:
        """Actualiza los contadores del encabezado."""
        self._etiqueta_resumen.config(
            text=f"Clientes: {len(self._sistema.clientes)}   |   "
                 f"Servicios: {len(self._sistema.servicios)}   |   "
                 f"Reservas: {len(self._sistema.reservas)}"
        )

    def _actualizar_clientes(self) -> None:
        """Llena la tabla de clientes desde el sistema."""
        # Se eliminan las filas anteriores y se insertan las actuales.
        for item in self._tabla_clientes.get_children():
            self._tabla_clientes.delete(item)
        for c in self._sistema.clientes:
            self._tabla_clientes.insert(
                "", "end", iid=c.id,
                values=(c.id, c.documento_mascarado(),
                        self._recortar(c.nombre_completo(), 30), c.tipo.value,
                        "Activo" if c.activo else "Inactivo"),
            )

    def _actualizar_servicios(self) -> None:
        """Llena la tabla de servicios desde el sistema."""
        for item in self._tabla_servicios.get_children():
            self._tabla_servicios.delete(item)
        for s in self._sistema.servicios:
            # La etiqueta corta depende de la clase real del servicio.
            tipo = ("Sala" if isinstance(s, ReservaSalas) else
                    "Equipos" if isinstance(s, AlquilerEquipos) else "Asesoría")
            self._tabla_servicios.insert(
                "", "end", iid=s.codigo,
                values=(s.codigo, self._recortar(s.nombre, 34), tipo,
                        formatear_moneda(s.tarifa_base),
                        "Sí" if s.disponible else "No"),
            )

    def _actualizar_reservas(self) -> None:
        """Llena la tabla de reservas desde el sistema."""
        for item in self._tabla_reservas.get_children():
            self._tabla_reservas.delete(item)
        for r in self._sistema.reservas:
            self._tabla_reservas.insert(
                "", "end", iid=r.id,
                values=(r.id, self._recortar(r.cliente.nombre_completo(), 24),
                        r.servicio.codigo, formatear_fecha(r.inicio),
                        r.estado.value, formatear_moneda(r.total)),
            )

    # -------------------------- ACCIONES CLIENTES ---------------------------
    def _registrar_cliente(self) -> None:
        """Valida el formulario y registra un cliente."""
        tipo = (TipoCliente.EMPRESA
                if self._cli_tipo.get() == TipoCliente.EMPRESA.value
                else TipoCliente.NATURAL)
        try:
            cliente = self._sistema.registrar_cliente(
                documento=self._cli_documento.get(),
                nombre=self._cli_nombre.get(),
                apellido=self._cli_apellido.get(),
                correo=self._cli_correo.get(),
                telefono=self._cli_telefono.get(),
                direccion=self._cli_direccion.get(),
                tipo=tipo,
            )
        except ErrorSistemaFJ as error:
            self._mostrar_error(error)
        except Exception as error:
            self._mostrar_error_inesperado(error)
        else:
            self._mostrar_ok(f"Cliente {cliente.id} registrado: {cliente.nombre_completo()}.")
            self._limpiar_cliente()
            self._actualizar_clientes()
            self._actualizar_resumen()

    def _limpiar_cliente(self) -> None:
        """Limpia el formulario de clientes."""
        for var in (self._cli_documento, self._cli_nombre, self._cli_apellido,
                    self._cli_correo, self._cli_telefono, self._cli_direccion):
            var.set("")
        self._cli_tipo.set(TipoCliente.NATURAL.value)

    def _reporte_naturales(self) -> None:
        """Muestra cuántos clientes naturales hay registrados."""
        total = self._sistema.contar_clientes_naturales()
        self._mostrar_ok(f"Clientes de tipo natural registrados: {total}.")

    # -------------------------- ACCIONES SERVICIOS --------------------------
    def _cambiar_tipo_servicio(self, evento=None) -> None:
        """Muestra los campos del tipo de servicio elegido."""
        for marco in (self._marco_sala, self._marco_equipo, self._marco_asesoria):
            marco.grid_remove()
        seleccion = self._srv_tipo.get()
        marco = (self._marco_sala if seleccion == self.TIPO_SALA else
                 self._marco_equipo if seleccion == self.TIPO_EQUIPO else
                 self._marco_asesoria)
        marco.grid()

    def _registrar_servicio(self) -> None:
        """Valida y registra el servicio seleccionado."""
        tipo, codigo = self._srv_tipo.get(), self._srv_codigo.get()
        nombre, tarifa = self._srv_nombre.get(), self._srv_tarifa.get()
        disponible = bool(self._srv_disponible.get())
        try:
            # Se construye la subclase correcta según el tipo elegido.
            if tipo == self.TIPO_SALA:
                # El texto del combo se convierte al enum TipoSala.
                tipo_sala = {t.value: t for t in TipoSala}.get(
                    self._srv_tipo_sala.get())
                if tipo_sala is None:
                    raise DatosInvalidosError("Seleccione un tipo de sala válido.")
                servicio = ReservaSalas(codigo, nombre, tarifa, tipo_sala,
                                        self._srv_capacidad.get(),
                                        bool(self._srv_equipada.get()), disponible)
            elif tipo == self.TIPO_EQUIPO:
                servicio = AlquilerEquipos(codigo, nombre, tarifa,
                                           self._srv_equipo.get(),
                                           self._srv_marca.get(),
                                           bool(self._srv_seguro.get()), disponible)
            else:
                nivel = {n.value: n for n in NivelAsesor}.get(self._srv_nivel.get())
                if nivel is None:
                    raise DatosInvalidosError("Seleccione un nivel de asesor válido.")
                servicio = AsesoriaEspecializada(
                    codigo, nombre, tarifa, self._srv_especialidad.get(),
                    nivel, self._srv_asesor.get(), disponible)
            # El sistema revisa duplicados y guarda el servicio en su lista.
            registrado = self._sistema.registrar_servicio(servicio)
        except ErrorSistemaFJ as error:
            self._mostrar_error(error)
        except Exception as error:
            self._mostrar_error_inesperado(error)
        else:
            self._mostrar_ok(f"Servicio {registrado.codigo} registrado: {registrado.nombre}.")
            self._limpiar_servicio()
            self._actualizar_servicios()
            self._actualizar_resumen()

    def _limpiar_servicio(self) -> None:
        """Limpia el formulario de servicios."""
        # Se vacían todos los campos; el código queda libre para el usuario.
        for var in (self._srv_codigo, self._srv_nombre, self._srv_tarifa,
                    self._srv_capacidad, self._srv_equipo, self._srv_marca,
                    self._srv_especialidad, self._srv_asesor):
            var.set("")
        self._srv_disponible.set(True)

    # -------------------------- ACCIONES RESERVAS ---------------------------
    def _crear_reserva(self) -> None:
        """Valida los datos y crea una reserva."""
        try:
            # Fecha y hora se reciben por separado y se unen en un datetime.
            try:
                inicio = datetime.strptime(
                    f"{self._res_fecha.get().strip()} {self._res_hora.get().strip()}",
                    "%d/%m/%Y %H:%M")
            except ValueError as error:
                raise DatosInvalidosError(
                    "La fecha u hora no es válida. Use DD/MM/AAAA y HH:MM."
                ) from error
            # Los porcentajes se escriben como 19 y 5; se convierten a 0.19 y 0.05.
            iva = convertir_decimal(self._res_iva.get().strip() or "19",
                                    "IVA (%)", Decimal("0"), Decimal("50"))
            descuento = convertir_decimal(self._res_descuento.get().strip() or "0",
                                          "descuento (%)", Decimal("0"),
                                          Decimal("50"))
            reserva = self._sistema.crear_reserva(
                documento_cliente=self._res_documento.get(),
                codigo_servicio=self._res_servicio.get(),
                fecha_hora_inicio=inicio,
                cantidad=self._res_cantidad.get(),
                impuesto=iva / Decimal("100"),
                descuento=descuento / Decimal("100"),
                observaciones=self._res_observaciones.get(),
            )
        except ErrorSistemaFJ as error:
            self._mostrar_error(error)
        except Exception as error:
            self._mostrar_error_inesperado(error)
        else:
            self._mostrar_ok(f"Reserva {reserva.id} creada por "
                             f"{formatear_moneda(reserva.total)}.")
            self._limpiar_reserva()
            self._actualizar_reservas()
            self._actualizar_resumen()

    def _limpiar_reserva(self) -> None:
        """Limpia el formulario de reservas."""
        # Se conservan los valores por defecto de fecha, hora e IVA.
        self._res_documento.set("")
        self._res_servicio.set("")
        self._res_cantidad.set("")
        self._res_observaciones.set("")
        self._res_motivo.set("")
        self._res_fecha.set((datetime.now() + timedelta(days=1)).strftime("%d/%m/%Y"))
        self._res_hora.set("09:00")

    def _reserva_seleccionada(self):
        """Devuelve la reserva seleccionada en la tabla."""
        # El identificador de cada fila es el mismo ID de la reserva.
        seleccion = self._tabla_reservas.selection()
        if not seleccion:
            messagebox.showinfo("Seleccione una reserva",
                                "Haga clic sobre una fila de la tabla.",
                                parent=self._ventana)
            return None
        try:
            return self._sistema.buscar_reserva(seleccion[0])
        except ErrorSistemaFJ as error:
            self._mostrar_error(error)
            return None

    def _confirmar_reserva(self) -> None:
        """Confirma la reserva seleccionada."""
        reserva = self._reserva_seleccionada()
        if reserva is None:
            return
        try:
            total = self._sistema.confirmar_reserva(reserva.id)
        except ErrorSistemaFJ as error:
            self._mostrar_error(error)
        except Exception as error:
            self._mostrar_error_inesperado(error)
        else:
            self._mostrar_ok(f"Reserva {reserva.id} confirmada por "
                             f"{formatear_moneda(total)}.")
            self._actualizar_reservas()
            self._actualizar_resumen()

    def _cancelar_reserva(self) -> None:
        """Cancela la reserva seleccionada con su motivo."""
        reserva = self._reserva_seleccionada()
        if reserva is None:
            return
        # El negocio exige un motivo no vacío para cancelar.
        motivo = self._res_motivo.get().strip()
        if not motivo:
            messagebox.showinfo("Motivo requerido",
                                "Escriba el motivo de la cancelación.",
                                parent=self._ventana)
            return
        try:
            self._sistema.cancelar_reserva(reserva.id, motivo)
        except ErrorSistemaFJ as error:
            self._mostrar_error(error)
        except Exception as error:
            self._mostrar_error_inesperado(error)
        else:
            self._mostrar_ok(f"Reserva {reserva.id} cancelada correctamente.")
            self._res_motivo.set("")
            self._actualizar_reservas()
            self._actualizar_resumen()

    def _procesar_reserva(self) -> None:
        """Procesa la reserva seleccionada."""
        reserva = self._reserva_seleccionada()
        if reserva is None:
            return
        try:
            total = self._sistema.procesar_reserva(reserva.id)
        except ErrorSistemaFJ as error:
            self._mostrar_error(error)
        except Exception as error:
            self._mostrar_error_inesperado(error)
        else:
            self._mostrar_ok(f"Reserva {reserva.id} procesada. "
                             f"Valor facturado: {formatear_moneda(total)}.")
            self._actualizar_reservas()
            self._actualizar_resumen()

    # ----------------------------- MENSAJES ---------------------------------
    def _mostrar_ok(self, mensaje: str) -> None:
        """Muestra un mensaje de éxito en la barra de estado."""
        self._etiqueta_estado.config(text=mensaje, fg=self.COLOR_EXITO)

    def _mostrar_error(self, error: Exception) -> None:
        """Muestra un error de negocio en pantalla y en el log."""
        # Los errores de negocio se registran como advertencia y no cierran la app.
        self._sistema.registro.advertencia(f"GUI: operación rechazada: {error}")
        self._etiqueta_estado.config(text=f"Error: {error}", fg=self.COLOR_ERROR)
        messagebox.showwarning("Operación rechazada", str(error),
                               parent=self._ventana)

    def _mostrar_error_inesperado(self, error: Exception) -> None:
        """Registra y muestra un error no controlado."""
        self._sistema.registro.critico("GUI: error no controlado.", error)
        self._etiqueta_estado.config(
            text="Error inesperado. Revise el archivo de logs.",
            fg=self.COLOR_ERROR)
        messagebox.showerror(
            "Error inesperado",
            f"Ocurrió un error inesperado.\n\n{error}\n\nRevise el archivo de logs.",
            parent=self._ventana)

    def _ver_log(self) -> None:
        """Abre una ventana con las últimas líneas del log."""
        ventana = tk.Toplevel(self._ventana)
        ventana.title("Registro de eventos - Software FJ")
        ventana.geometry("900x520")
        ventana.configure(bg=self.COLOR_FONDO)
        marco = ttk.Frame(ventana, padding=10)
        marco.pack(fill="both", expand=True)
        texto = tk.Text(marco, wrap="none", font=("Consolas", 9),
                        background="white", foreground=self.COLOR_TEXTO)
        barra = ttk.Scrollbar(marco, orient="vertical", command=texto.yview)
        texto.configure(yscrollcommand=barra.set)
        texto.pack(side="left", fill="both", expand=True)
        barra.pack(side="right", fill="y")
        try:
            with open(self._sistema.registro.ruta_archivo, "r",
                      encoding="utf-8", errors="replace") as archivo:
                lineas = archivo.readlines()[-200:]
        except OSError as error:
            lineas = [f"No se pudo leer el archivo de logs:\n{error}\n"]
        texto.insert("1.0", "".join(lineas))
        texto.configure(state="disabled")

    def _cerrar(self) -> None:
        """Pide confirmación y cierra la ventana."""
        if messagebox.askokcancel("Cerrar Software FJ",
                                  "¿Desea cerrar la aplicación?",
                                  parent=self._ventana):
            self._ventana.destroy()

    def _centrar_ventana(self) -> None:
        """Centra la ventana en la pantalla."""
        self._ventana.update_idletasks()
        x = max(0, (self._ventana.winfo_screenwidth() - self.ANCHO) // 2)
        y = max(0, (self._ventana.winfo_screenheight() - self.ALTO) // 3)
        self._ventana.geometry(f"{self.ANCHO}x{self.ALTO}+{x}+{y}")

def iniciar_interfaz_grafica(sistema: "SistemaGestionFJ") -> bool:
    """Intenta abrir la interfaz gráfica."""
    if not TKINTER_DISPONIBLE:
        sistema.registro.advertencia(
            "Tkinter no está disponible; se usará la interfaz de consola."
        )
        print("[AVISO] Tkinter no está disponible. Se iniciará la consola.")
        return False
    try:
        ventana = VentanaSoftwareFJ(sistema)
    except tk.TclError as error:

        sistema.registro.error(
            "No se pudo iniciar la interfaz gráfica (TclError).", error
        )
        print("[AVISO] No hay entorno gráfico disponible. Se iniciará la consola.")
        return False
    except Exception as error:
        sistema.registro.critico(
            "Error al construir la interfaz gráfica; se usará la consola.", error
        )
        print("[AVISO] No se pudo iniciar la interfaz gráfica. Se usará la consola.")
        return False
    ventana.iniciar()
    return True

# SECCIÓN 4. EXCEPCIONES PERSONALIZADAS
# Todas las excepciones del negocio heredan de ErrorSistemaFJ. Así el programa
# puede capturar "cualquier error controlado" con un solo except, mientras que
# los errores técnicos de Python (ValueError, OSError, etc.) se tratan aparte.
class ErrorSistemaFJ(Exception):
    """Excepción raíz de todos los errores controlados del sistema."""

    def __init__(self, mensaje: str, detalle: str = "") -> None:
        """Guarda el mensaje y el detalle del error."""
        # El detalle es opcional y se usa para dar más contexto en el log.
        self.mensaje = mensaje
        self.detalle = detalle
        texto = mensaje if not detalle else f"{mensaje} Detalle: {detalle}"
        super().__init__(texto)

# Errores de validación de datos.
class DatosInvalidosError(ErrorSistemaFJ):
    """Se lanza cuando un dato no cumple las reglas de validación."""

# Errores de registro y búsqueda de entidades.
class EntidadDuplicadaError(ErrorSistemaFJ):
    """Se lanza al intentar registrar un cliente o servicio ya existente."""

class EntidadNoEncontradaError(ErrorSistemaFJ):
    """Se lanza cuando se busca una entidad que no existe."""

class ClienteNoEncontradoError(EntidadNoEncontradaError):
    """Caso específico: el documento del cliente no está registrado."""

class ServicioNoEncontradoError(EntidadNoEncontradaError):
    """Caso específico: el código del servicio no está registrado."""

# Errores relacionados con los servicios.
class ServicioNoDisponibleError(ErrorSistemaFJ):
    """El servicio existe, pero está marcado como no disponible."""

# Errores relacionados con las reservas y sus estados.
class ReservaInvalidaError(ErrorSistemaFJ):
    """La reserva no puede crearse o no cumple las reglas del negocio."""

class ConflictoAgendaError(ReservaInvalidaError):
    """Ya existe otra reserva que se cruza en horario."""

class OperacionNoPermitidaError(ErrorSistemaFJ):
