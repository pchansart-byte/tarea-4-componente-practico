    # =========================================================================
    # PESTAÑA SERVICIOS
    # =========================================================================
    def _construir_pestana_servicios(self) -> None:
        """
        Formulario de servicios con campos comunes y campos específicos.

        Los campos de sala, equipo y asesoría se crean en tres marcos distintos
        y solo se muestra el que corresponde al tipo seleccionado. Así el
        formulario se mantiene simple sin llenarse de campos que no aplican.
        """
        pestana = ttk.Frame(self._cuaderno, padding=10)
        self._cuaderno.add(pestana, text="   Servicios   ")
        pestana.columnconfigure(0, weight=0, minsize=400)
        pestana.columnconfigure(1, weight=1)
        pestana.rowconfigure(0, weight=1)

        formulario = ttk.LabelFrame(pestana, text=" Registrar servicio ", padding=12)
        formulario.grid(row=0, column=0, sticky="nsew", padx=(0, 10))
        formulario.columnconfigure(1, weight=1)

        # Campos comunes a los tres servicios.
        self._combo_tipo_servicio = self._crear_combo(
            formulario,
            0,
            "Tipo de servicio:",
            self._srv_tipo,
            [self.TIPO_SALA, self.TIPO_EQUIPO, self.TIPO_ASESORIA],
        )
        self._combo_tipo_servicio.bind(
            "<<ComboboxSelected>>", self._cambiar_tipo_servicio
        )
        self._crear_campo(formulario, 1, "Código único:", self._srv_codigo)
        self._crear_campo(formulario, 2, "Nombre:", self._srv_nombre)
        self._crear_campo(formulario, 3, "Tarifa base:", self._srv_tarifa)

        # Marco con los campos propios de una sala.
        self._marco_sala = ttk.Frame(formulario)
        self._marco_sala.columnconfigure(1, weight=1)
        self._crear_combo(
            self._marco_sala,
            0,
            "Tipo de sala:",
            self._srv_tipo_sala,
            [tipo.value for tipo in TipoSala],
        )
        self._crear_campo(self._marco_sala, 1, "Capacidad:", self._srv_capacidad)
        ttk.Checkbutton(
            self._marco_sala,
            text="Incluye equipamiento audiovisual",
            variable=self._srv_equipada,
        ).grid(row=2, column=0, columnspan=2, sticky="w", pady=4)

        # Marco con los campos propios de un equipo.
        self._marco_equipo = ttk.Frame(formulario)
        self._marco_equipo.columnconfigure(1, weight=1)
        self._crear_campo(self._marco_equipo, 0, "Equipo:", self._srv_equipo)
        self._crear_campo(self._marco_equipo, 1, "Marca:", self._srv_marca)
        ttk.Checkbutton(
            self._marco_equipo,
            text="Incluye seguro del 8%",
            variable=self._srv_seguro,
        ).grid(row=2, column=0, columnspan=2, sticky="w", pady=4)

        # Marco con los campos propios de una asesoría.
        self._marco_asesoria = ttk.Frame(formulario)
        self._marco_asesoria.columnconfigure(1, weight=1)
        self._crear_campo(
            self._marco_asesoria, 0, "Especialidad:", self._srv_especialidad
        )
        self._crear_combo(
            self._marco_asesoria,
            1,
            "Nivel del asesor:",
            self._srv_nivel,
            [nivel.value for nivel in NivelAsesor],
        )
        self._crear_campo(self._marco_asesoria, 2, "Asesor:", self._srv_asesor)

        # Los tres marcos ocupan la misma celda; luego se ocultan dos.
        for marco in (self._marco_sala, self._marco_equipo, self._marco_asesoria):
            marco.grid(row=4, column=0, columnspan=2, sticky="ew", pady=(4, 0))

        ttk.Checkbutton(
            formulario,
            text="Disponible para reservas",
            variable=self._srv_disponible,
        ).grid(row=5, column=0, columnspan=2, sticky="w", pady=(8, 0))

        ttk.Button(
            formulario,
            text="Registrar servicio",
            style="Accion.TButton",
            command=self._registrar_servicio,
        ).grid(row=6, column=0, columnspan=2, sticky="ew", pady=(12, 0))

        # ------------------------------- Tabla ------------------------------
        lista = ttk.LabelFrame(pestana, text=" Servicios registrados ", padding=10)
        lista.grid(row=0, column=1, sticky="nsew")
        lista.rowconfigure(0, weight=1)
        lista.columnconfigure(0, weight=1)

        self._tabla_servicios = self._crear_tabla(
