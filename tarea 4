# SECCIÓN 12. ENTRADA DE DATOS POR CONSOLA (INTERFAZ SUPER SIMPLE)
# El objetivo es que cualquier persona pueda usar el programa sin manual:
# menú numerado, preguntas claras y mensajes de error en español.

def configurar_consola() -> None:
    """Fuerza UTF-8 en la salida para que las tildes se vean bien."""
    # Se intenta en stdout y stderr; si una consola no lo permite, se ignora.
    for flujo in (sys.stdout, sys.stderr):
        try:
            flujo.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError, OSError):
            continue

def pedir_texto(mensaje: str, obligatorio: bool = True,
                longitud_maxima: int = 80,
                valor_defecto: Optional[str] = None) -> str:
    """Pide un texto; lanza SalidaSolicitada si se acaba la entrada."""
    # El bucle se repite hasta que el dato cumpla las condiciones.
    while True:
        try:
            entrada = input(mensaje).strip()
        except EOFError as error:
            # Ctrl+D, Ctrl+Z o entrada redirigida terminan el programa.
            raise SalidaSolicitada("Fin de la entrada estándar.") from error
        if not entrada:
            if valor_defecto is not None:
                return valor_defecto
            if not obligatorio:
                return ""
            print("  [!] Este dato es obligatorio.")
            continue
        if len(entrada) > longitud_maxima:
            print(f"  [!] Máximo {longitud_maxima} caracteres.")
            continue
        return entrada

def pedir_opcion(mensaje: str, opciones_validas: tuple) -> str:
    """Repite hasta recibir una opción válida."""
    while True:
        valor = pedir_texto(mensaje)
        if valor in opciones_validas:
            return valor
        print(f"  [!] Opción no válida: {', '.join(opciones_validas)}.")

def pedir_entero(mensaje: str, minimo: int, maximo: int,
                 valor_defecto: Optional[int] = None) -> int:
    """Pide un entero dentro de un rango."""
    # Si el usuario deja vacío y hay valor por defecto, se usa ese valor.
    while True:
        texto = pedir_texto(mensaje, obligatorio=False)
        if not texto:
            if valor_defecto is not None:
                return valor_defecto
            print("  [!] Debe ingresar un entero.")
            continue
        try:
            return convertir_entero(texto, "valor", minimo, maximo)
        except ErrorSistemaFJ as error:
            print(f"  [!] {error}")

def pedir_decimal(mensaje: str, minimo: Optional[Decimal] = None,
                  maximo: Optional[Decimal] = None,
                  valor_defecto: Optional[Decimal] = None) -> Decimal:
    """Pide un decimal dentro de un rango."""
    while True:
        texto = pedir_texto(mensaje, obligatorio=False)
        if not texto:
            if valor_defecto is not None:
                return valor_defecto
            print("  [!] Debe ingresar un número.")
            continue
        try:
            return convertir_decimal(texto, "valor", minimo, maximo)
        except ErrorSistemaFJ as error:
            print(f"  [!] {error}")

def pedir_si_no(mensaje: str, defecto: bool = True) -> bool:
    """Pregunta de sí o no con valor por defecto."""
    while True:
        texto = pedir_texto(mensaje, obligatorio=False).lower()
        if texto == "":
            return defecto
        if texto in ("s", "si", "sí"):
            return True
        if texto in ("n", "no"):
            return False
        print("  [!] Responda 's' o 'n'.")

def pedir_fecha_hora(mensaje: str) -> datetime:
    """Pide una fecha y hora con formato DD/MM/AAAA HH:MM."""
    while True:
        texto = pedir_texto(f"{mensaje} (DD/MM/AAAA HH:MM): ")
        try:
            return datetime.strptime(texto, "%d/%m/%Y %H:%M")
        except ValueError:
            print("  [!] Fecha inválida. Ejemplo: 25/11/2026 14:30")

def pausar() -> None:
